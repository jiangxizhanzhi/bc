<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.assess.dao.mapper.AssessDataMapper">


    <sql id="Base_Column_List">
        id
        ,resource_id,`name`,
        description,create_user_id,tag,
        logo,`type`,input_type,file_name,
        input_data,result_data,create_time,
        update_time
    </sql>
    <select id="listAssessData" resultType="com.cyberpeace.assess.dao.entity.AssessData">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select resource_id,`name`,
        description,create_user_id,tag,
        logo,`type`,input_type,file_name,
        input_data,result_data,create_time,
        update_time
        from assess_data
        <where>
            type = #{type}
            <if test="pattern != null and pattern != ''">
                and `name` like #{pattern}
            </if>

        </where>
    </select>
</mapper>
