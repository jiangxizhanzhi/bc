<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.assess.dao.mapper.AssessFileDataMapper">


    <sql id="Base_Column_List">
        id
        ,resource_id,content,
        path,related_id,create_time,
        update_time
    </sql>
    <delete id="deleteByRelatedId">
        delete
        FROM assess_file_data
        WHERE related_id = #{relatedId}
    </delete>

    <select id="getDataBaseTableByRelatedId" resultType="java.lang.String">
        SELECT content
        FROM assess_file_data
        WHERE related_id = #{relatedId}
    </select>
</mapper>
