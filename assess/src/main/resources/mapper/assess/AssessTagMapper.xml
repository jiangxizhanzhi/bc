<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.assess.dao.mapper.AssessTagMapper">


    <sql id="Base_Column_List">
        id
        ,resource_id,content,
        create_time,update_time
    </sql>
    <select id="listAssessTag" resultType="com.cyberpeace.assess.dao.entity.AssessTag">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select resource_id,content,
        create_time,update_time
        from assess_tag
        <where>
            <if test="pattern != null and pattern != ''">
                `content` like #{pattern}
            </if>
        </where>

    </select>
</mapper>
