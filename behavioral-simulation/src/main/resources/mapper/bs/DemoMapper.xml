<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.bs.dao.mapper.DemoMapper">
    <insert id="saveParam">
        insert into `bs_param`
        values (DEFAULT, #{deviceId}, #{environmentId}, #{projectId})
    </insert>
    <select id="selectLatest" resultType="com.cyberpeace.bs.service.bo.demo.TaskParam">
        select device_id, environment_id, project_id
        from bs_param
        order by id desc
        limit 1
    </select>
</mapper>