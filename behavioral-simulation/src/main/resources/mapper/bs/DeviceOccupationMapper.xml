<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.bs.dao.mapper.DeviceOccupationMapper">
    <insert id="occupy">
        insert into bs_device_occupation
        (`device_id`, `scene_id`, `create_time`)
        values
        <foreach collection="selectedIds" item="deviceId" separator=",">
            (#{deviceId}, #{sceneId}, #{date})
        </foreach>
    </insert>
    <delete id="releaseBySceneId">
        delete
        from bs_device_occupation
        where scene_id = #{sceneId}
    </delete>
    <delete id="releaseBySceneIdList">
        delete
        from bs_device_occupation
        where scene_id in
        <foreach collection="sceneIdList" item="sceneId" open="(" close=")" separator=",">
            #{sceneId}
        </foreach>
    </delete>

    <select id="checkOccupation" resultType="java.lang.String">
        select device_id
        from bs_device_occupation
        where device_id in
        <foreach collection="deviceIds" item="deviceId" open="(" close=")" separator=",">
            #{deviceId}
        </foreach>
    </select>
    <select id="batchGetByIds" resultType="com.cyberpeace.bs.dao.entity.DeviceOccupation">
        select * from bs_device_occupation
        where device_id in
        <foreach collection="deviceIds" item="deviceId" open="(" close=")" separator=",">
            #{deviceId}
        </foreach>
    </select>
</mapper>