<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.bs.dao.mapper.UserModelMapper">
    <select id="pageUserBehaviors" resultType="com.cyberpeace.bs.dao.entity.UserModel">
        <if test="pattern != null and pattern != ''">
            <bind name="search" value="'%' + pattern + '%'"/>
        </if>
        select
        resource_id,
        user_name,
        user_type_id,
        access_habit,
        access_config,
        access_os,
        behavior_list,
        bandwidth_limited,
        bandwidth
        from bs_user_model
        <where>
            <if test="userTypeId != null and userTypeId != ''">
                and user_type_id = #{userTypeId}
            </if>

            <if test="pattern != null and pattern != ''">
                and user_name like #{search}
            </if>

            <if test="accessOs != null and accessOs != 0">
                and access_os = #{accessOs}
            </if>

        </where>
        order by id desc
    </select>
    <select id="selectBatchIdsOrderByIdDesc" resultType="com.cyberpeace.bs.dao.entity.UserModel">
        select * from bs_user_model
        where resource_id in
        <foreach collection="userModelIds" item="userModelId" separator="," open="(" close=")">
            #{userModelId}
        </foreach>
        order by id desc
    </select>
    <select id="existByName" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from bs_user_model
        where `user_name` = #{name}
        <if test="resourceId != null and resourceId != ''">
            and resource_id != #{resourceId}
        </if>)
        then 1
        else 0
        end
        as result;
    </select>
</mapper>