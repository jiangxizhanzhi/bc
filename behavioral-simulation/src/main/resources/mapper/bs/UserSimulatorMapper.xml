<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.bs.dao.mapper.UserSimulatorMapper">
    <delete id="deleteBySceneId">
        delete
        from bs_user_simulator
        where scene_id = #{sceneId}
    </delete>
    <delete id="deleteBySceneIdList">
        delete
        from bs_user_simulator
        where scene_id in
        <foreach collection="sceneIdList" item="sceneId" open="(" close=")" separator=",">
            #{sceneId}
        </foreach>
    </delete>
    <select id="selectAll" resultType="com.cyberpeace.bs.dao.entity.UserSimulator">
        select *
        from bs_user_simulator
        order by id desc
    </select>
    <select id="countAll" resultType="java.lang.Integer">
        select count(id)
        from bs_user_simulator
    </select>
    <select id="countByStatus" resultType="java.lang.Integer">
        select count(id)
        from bs_user_simulator
        where status = #{statusCode}
    </select>
    <select id="page" resultType="com.cyberpeace.bs.dao.entity.UserSimulator">
        select *
        from bs_user_simulator
        <if test="sceneId != null and sceneId != ''">
            where scene_id = #{sceneId}
        </if>
        order by id desc
    </select>
    <select id="getIdsBySceneId" resultType="java.lang.String">
        select resource_id
        from bs_user_simulator
        where scene_id = #{sceneId}
    </select>
    <select id="getSceneList" resultType="com.cyberpeace.bs.service.bo.simulator.SceneIdName">
        select distinct scene_id, scene_name
        from bs_user_simulator
    </select>
    <select id="getIdsBySceneIdList" resultType="java.lang.String">
        select resource_id
        from bs_user_simulator
        where scene_id in
        <foreach collection="sceneIdList" item="sceneId" open="(" close=")" separator=",">
            #{sceneId}
        </foreach>
    </select>
    <select id="selectByNodeId" resultType="com.cyberpeace.bs.dao.entity.UserSimulator">
        select *
        from bs_user_simulator
        where device_id = #{nodeId}
    </select>
    <select id="selectBatchBySceneId" resultType="com.cyberpeace.bs.dao.entity.UserSimulator">
        select *
        from bs_user_simulator
        where scene_id = #{sceneId}
    </select>
    <select id="selectBatchByStatus" resultType="com.cyberpeace.bs.dao.entity.UserSimulator">
        select *
        from bs_user_simulator
        where status = #{code}
    </select>
    <select id="getIdsByDeviceIds" resultType="java.lang.String">
        select resource_id from bs_user_simulator
        where device_id in
        <foreach collection="deviceIds" item="deviceId" open="(" close=")" separator=",">
            #{deviceId}
        </foreach>
    </select>
</mapper>