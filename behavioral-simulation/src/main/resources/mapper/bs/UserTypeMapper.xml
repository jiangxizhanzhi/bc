<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.bs.dao.mapper.UserTypeMapper">
    <select id="page" resultType="com.cyberpeace.bs.service.bo.user.UserTypeBo">
        <if test="search != null and search != ''">
            <bind name="search1" value="'%' + search + '%'"/>
        </if>
        select
        resource_id,
        `name`,
        create_time
        from bs_user_type
        <where>
            <if test="search != null and search != ''">
                name like #{search1}
            </if>
        </where>
        order by id desc
    </select>
    <select id="existByName" resultType="java.lang.Boolean">
        select case when exists
        (
        select 1
        from bs_user_type
        where `name` = #{name}
        <if test="selfId != null and selfId != ''">
            and resource_id != #{selfId}
        </if>
        )
        then 1
        else 0
        end
        as result;
    </select>
</mapper>