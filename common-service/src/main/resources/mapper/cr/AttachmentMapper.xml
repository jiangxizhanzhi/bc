<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cs.dao.mapper.AttachmentMapper">
    <resultMap id="base" type="com.cyberpeace.cs.dao.entity.Attachment">
        <result property="isPublic" column="public"/>
    </resultMap>
    <insert id="batchInsert">
        insert into attachment
        (resource_id, file_name, file_path, create_time,
        update_time, `public`)
        values
        <foreach collection="attachments" item="attachment" separator=",">
            (#{attachment.resourceId}, #{attachment.fileName}, #{attachment.filePath}, now(),
            now(), #{attachment.isPublic})
        </foreach>
    </insert>

    <select id="selectBatchIds" resultMap="base">
        select * from attachment
        <where>
            <if test="attachmentIds != null and attachmentIds.size() != 0">
                resource_id in
                <foreach collection="attachmentIds" item="attachmentId" separator="," close=")" open="(">
                    #{attachmentId}
                </foreach>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByPath" resultMap="base">
        select *
        from attachment
        where file_path = #{filePath}
    </select>
</mapper>
