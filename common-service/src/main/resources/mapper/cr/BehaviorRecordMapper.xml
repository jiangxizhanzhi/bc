<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.cs.dao.mapper.BehaviorRecordMapper">
    <select id="selectAll" resultType="com.cyberpeace.cs.dao.entity.BehaviorRecordEntity">
        select *
        from behavior_record
    </select>
    <select id="selectByModuleAndAction" resultType="com.cyberpeace.cs.dao.entity.BehaviorRecordEntity">
        select *
        from behavior_record
        where module = #{module}
          and action = #{action}
    </select>
</mapper>