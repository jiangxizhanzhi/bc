<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cs.dao.mapper.ClassroomScoreMapper">
    <resultMap id="classroomScore" type="com.cyberpeace.cs.dao.entity.ClassroomScore"></resultMap>

    <select id="listByClassroomIdAndUserId" resultMap="classroomScore">

        select *
        from oj_classroom_scores
        <where>
            classroom_id = #{classroomId}
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
        </where>
    </select>

    <select id="listUserIdByClassroomId" resultType="java.lang.String">

        select user_id
        from oj_classroom_scores
        <where>
            classroom_id = #{classroomId}
        </where>
    </select>

    <delete id="clearByTaskId">
        delete
        from oj_classroom_scores
        where task_id = #{taskId}
    </delete>

    <delete id="clearByClassroomId">
        delete
        from oj_classroom_scores
        where classroom_id = #{classroomId}
    </delete>

    <select id="selectByLessonIdAndUserId" resultMap="classroomScore">
        select *
        from oj_classroom_scores
        <where>
            lesson_id = #{lessonId}
            and user_id = #{userId}
        </where>
    </select>

    <select id="isTaskFinished" resultType="boolean">
        select case
                   when
                           (select count(1)
                            from oj_classroom_scores
                            where task_id = #{taskId}
                              and score = 0
                           ) = 0 then 1
                   else 0 end
    </select>

</mapper>
