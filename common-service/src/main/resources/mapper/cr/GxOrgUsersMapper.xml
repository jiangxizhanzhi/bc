<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cs.dao.mapper.GxOrgUsersMapper">
    <resultMap id="gxOrgUsers" type="com.cyberpeace.cs.dao.entity.GxOrgUsers"></resultMap>

    <select id="getByClassRoomId" resultType="java.lang.String">

        select resource_id
        from sjyc_org_users
        <where>
            class_room_id = #{classRoomId}
        </where>
    </select>

    <select id="getOrgIdsByUserId" resultType="java.lang.String">
        select resource_id
        from sjyc_org_users
        <where>
            <if test="userId != null and userId != ''">
                <bind name="likeUserId" value="'%' + userId + '%'"/>
                and user_ids like #{likeUserId}
            </if>
        </where>
    </select>

</mapper>
