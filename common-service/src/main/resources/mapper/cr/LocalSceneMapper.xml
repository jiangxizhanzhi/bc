<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cs.dao.mapper.LocalSceneMapper">
    <resultMap id="baseResultMap" type="com.cyberpeace.cs.dao.entity.LocalScene"/>

    <select id="getByBusinessInstanceId" resultType="com.cyberpeace.cs.dao.entity.LocalScene">
        select *
        from local_scene
        where business_instance_id = #{businessInstanceId}
    </select>

    <update id="updateEndTime">
        update local_scene
        <set>
            start_time = #{startTime},
            end_time = #{endTime},
            scene_ttl = #{sceneTtl}
        </set>
        where resource_id = #{resourceId}
    </update>

    <select id="selectByCloseTime" resultMap="baseResultMap">
        select * from local_scene
        where end_time &lt; #{closeTime}
        and scene_status = 1
    </select>

    <select id="selectBetweenEndTime" resultMap="baseResultMap">
        select * from local_scene
        where end_time &gt;= #{start_time}
          and end_time &lt;= #{end_time}
          and scene_status = 1
    </select>

    <select id="selectBySceneId" resultMap="baseResultMap">
        select *
        from local_scene
        where mp_scene_id = #{sceneId}
    </select>

    <select id="selectAll" resultMap="baseResultMap">
        select *
        from local_scene
    </select>
    <select id="selectByBusinessInstanceId" resultType="com.cyberpeace.cs.dao.entity.LocalScene">
        select *
        from local_scene
        where business_instance_id = #{businessInstanceId}
    </select>
    <select id="selectLocalSceneByTopoId" resultType="com.cyberpeace.cs.dao.entity.LocalScene">
        select * from local_scene where topo_id = #{topoId}
    </select>
    <select id="selectLocalSceneBytemplateId" resultType="com.cyberpeace.cs.dao.entity.LocalScene">
        SELECT ls.* FROM cr_eval_task as  cet INNER JOIN local_scene as ls on cet.local_scene_id = ls.resource_id WHERE cet.template_id = #{resourceId}
    </select>
</mapper>
