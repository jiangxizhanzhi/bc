<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cs.dao.mapper.LocalSceneMapper">
    <resultMap id="baseResultMap" type="com.cyberpeace.cs.dao.entity.LocalScene"/>

    <select id="getByBusinessInstanceId" resultType="com.cyberpeace.cs.dao.entity.LocalScene">
        select *
        from local_scene
        where business_instance_id = #{businessInstanceId}
    </select>

    <update id="updateEndTime">
        update local_scene
        set destroy_time = #{destroyTime},
        scene_ttl = #{sceneTtl}
        where resource_id = #{resourceId}
    </update>

    <select id="selectByCloseTime" resultMap="baseResultMap">
        select * from local_scene
        where end_time &lt; #{closeTime}
        and scene_status != 3
    </select>
</mapper>
