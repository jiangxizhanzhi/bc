<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cs.dao.mapper.PageConfigItemMapper">

    <resultMap id="base" type="com.cyberpeace.cs.dao.entity.PageConfigItem"/>

    <select id="selectByType" resultMap="base">
        select * from page_config_item
        where `type` = #{type}
    </select>
</mapper>
