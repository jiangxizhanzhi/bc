<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cs.dao.mapper.SystemUseStatusMapper">
    <resultMap id="baseResultMap" type="com.cyberpeace.cs.dao.entity.SystemUseStatus"/>

    <select id="selectList" resultMap="baseResultMap">
        select *
        from system_use_status
        <choose>
            <when test="@com.cyberpeace.config.db.MybatisConfig@DB_TYPE == 'dm'">
                where alter_time &gt; SYSDATE - INTERVAL '12' HOUR and alter_time &lt; now()
            </when>
            <otherwise>
                where alter_time &gt; date_sub(now(), interval 12 hour) and alter_time &lt; now()
            </otherwise>
        </choose>
    </select>

    <delete id="deleteOverdueData">
        delete
        from system_use_status
        <choose>
            <when test="@com.cyberpeace.config.db.MybatisConfig@DB_TYPE == 'dm'">
                where alter_time &lt; SYSDATE - INTERVAL '36' HOUR
            </when>
            <otherwise>
                where alter_time &lt; date_sub(now(), interval 36 hour)
            </otherwise>
        </choose>
    </delete>
</mapper>
