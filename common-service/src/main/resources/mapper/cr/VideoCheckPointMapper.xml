<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.cs.dao.mapper.VideoCheckPointMapper">
    <select id="selectByPath" resultType="com.cyberpeace.cs.dao.entity.VideoCheckPoint">
        select *
        from video_check_point
        where path = #{videoPath}
    </select>
</mapper>