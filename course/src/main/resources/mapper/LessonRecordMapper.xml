<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonRecordMapper">

    <select id="selectByCourseAndUser" resultType="com.cyberpeace.oj.course.dao.entity.LessonRecord">
        select * from course_lessonrecord
        <where>
            <if test="null != userId and userId != ''">
                user = #{userId}
            </if>

        </where>
    </select>

    <select id="idsByCoursesAndUser" resultType="java.lang.String">
        select lesson from course_lessonrecord
        <where>
            <if test="null != userId and userId != ''">
                user = #{userId}
            </if>
        </where>
    </select>

</mapper>
