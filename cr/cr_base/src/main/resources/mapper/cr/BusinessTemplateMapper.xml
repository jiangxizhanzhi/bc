<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.BusinessTemplateMapper">

    <sql id="share_constant">
        <bind name="ALL_SHARE_MODE" value="@com.cyberpeace.common.model.AuthTable$AuthType@ALL_SHARE_MODE.code"/>
        <bind name="CUSTOM_SHARE_MODE" value="@com.cyberpeace.common.model.AuthTable$AuthType@CUSTOM_SHARE_MODE.code"/>
    </sql>

    <select id="listTeamTemplate" resultType="com.cyberpeace.cr.crbase.dao.entity.BusinessTemplateData">
        <if test="listQuery.search != null and listQuery.search != ''">
            <bind name="search" value="'%' + listQuery.search + '%'"/>
        </if>
        select
        resource_id ,topo_id,`name`, description,business_type,difficulty,local_scene_id,
        create_user_id,operation_auth_type,operation_auth_ids, read_auth_type, read_auth_ids,create_time
        from
        cr_business_template
        <where>
            cr_business_template.resource_id in
            <if test="listQuery.ids != null and listQuery.ids.size() != 0">
                <foreach collection="listQuery.ids" item="templateId" separator="," close=")" open="(">
                    #{templateId}
                </foreach>
            </if>
            <if test="listQuery.ids.size() == 0">
                ('')
            </if>

            <if test="listQuery.search != null and listQuery.search != ''">
                and cr_business_template.name like #{search}
            </if>
            <if test="listQuery.type != null and listQuery.type != ''">
                and cr_business_template.business_type = #{listQuery.type}
            </if>
        </where>

    </select>
    <select id="selectIdsByUserId" resultType="java.lang.String" parameterType="java.lang.String">
        <if test="userId != null and userId != ''">
            <bind name="likeUserId" value="'%' + userId + '%'"/>
        </if>
        <include refid="share_constant"/>
        select
        resource_id
        from
        cr_business_template where

        (`operation_auth_type` = ${ALL_SHARE_MODE} or (`operation_auth_type` = ${CUSTOM_SHARE_MODE} and
        `operation_auth_ids` like
        #{likeUserId}) or `create_user_id` =#{userId})
    </select>

    <select id="selectByNameAndType" resultType="com.cyberpeace.cr.crbase.dao.entity.BusinessTemplate">
        select *
        from cr_business_template
        where `name` = #{name}
        and business_type = #{type}
        <if test="id != null and id != ''">
            and resource_id != #{id}
        </if>
    </select>

    <select id="selectByLocalSceneId" resultType="com.cyberpeace.cr.crbase.dao.entity.BusinessTemplate">
        select *
        from cr_business_template
        where local_scene_id = #{localSceneId}
    </select>
    <select id="existByName" resultType="java.lang.Boolean">
        select case
                   when exists(select 1
                               from cr_business_template
                               where name = #{templateName})
                       then 1
                   else 0
                   end
                   as result;
    </select>

    <select id="getExistedNames" resultType="java.lang.String">
        select name from cr_business_template
        where name in
        <foreach collection="templateNames" separator="," open="(" close=")" item="templateName">
            #{templateName}
        </foreach>
    </select>

    <select id="existByNameAndTypeAndId" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_business_template
        where `name` = #{templateName}
        and business_type = #{type}
        <if test="templateId != null and templateId != ''">
            and resource_id != #{templateId}
        </if>)
        then 1
        else 0
        end
        as result;
    </select>
    <select id="getAttackRelatedIds" resultType="java.lang.String">
        select business_template_id from rtks_attack_train_relation
        where business_template_id
        in
        <foreach collection="businessTemplateIds" item="businessTemplateId" separator="," open="(" close=")">
            #{businessTemplateId}
        </foreach>
    </select>
    <select id="getEngageRelatedIds" resultType="java.lang.String">
        select business_template_id from rtks_engage_train_relation
        where business_template_id
        in
        <foreach collection="businessTemplateIds" item="businessTemplateId" separator="," open="(" close=")">
            #{businessTemplateId}
        </foreach>
    </select>
    <select id="listSimple"
            resultType="com.cyberpeace.cr.crbase.service.context.template.BusinessTemplateSimple">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select resource_id,
        name,
        business_type as type,
        difficulty
        from cr_business_template
        <where>
            <if test="type != null">
                and business_type = #{type}
            </if>
            <if test="difficulty != null">
                and difficulty = #{difficulty}
            </if>
            <if test="pattern != null and pattern !=''">
                and name like #{pattern}
            </if>
        </where>
        order by update_time desc
    </select>
    <select id="getIdByName" resultType="java.lang.String">
        select resource_id
        from cr_business_template
        where name = #{templateName}
    </select>
    <select id="getBatchIdsByNames" resultType="java.lang.String">
        select resource_id
        from cr_business_template
        <where>
            name in
            <foreach collection="business_template_names" separator="," open="(" close=")"
                     item="business_template_name">
                #{business_template_name}
            </foreach>
            and business_type = #{type}
        </where>
    </select>

    <select id="getAllByIds" resultType="com.cyberpeace.cr.crbase.dao.entity.BusinessTemplate">
        select *
        from cr_business_template
        where resource_id in
        <foreach collection="resourceIds" separator="," open="(" close=")" item="resource_id">
            #{resource_id}
        </foreach>
        and business_type = #{type}
    </select>


</mapper>
