<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.CrMarkMapper">
    <select id="selectByRoomId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrMark">
        select *
        from cr_mark
        where room_id = #{roomId}
    </select>
    <select id="selectByRoomIdAndUserId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrMark">
        select *
        from cr_mark
        where room_id = #{roomId}
          and user_id = #{userId}
    </select>
</mapper>