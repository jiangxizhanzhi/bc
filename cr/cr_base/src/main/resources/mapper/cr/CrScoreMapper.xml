<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.CrScoreMapper">

    <select id="getByRoomIdAndUser" resultType="com.cyberpeace.cr.crbase.dao.entity.CrScore">
        select resource_id,
               room_id,
               user_id,
               training_score,
               training_percentage,
               skill_percentage,
               skill_score,
               comment,
               final_score
        from cr_score
        where 1 = 1
          and room_id = #{roomId}
          and user_id = #{userId}
    </select>

    <select id="selectByRoomIdAndUserIds" resultType="com.cyberpeace.cr.crbase.dao.entity.CrScore">
        select resource_id,
        room_id,
        user_id,
        training_score,
        training_percentage,
        skill_percentage,
        skill_score,
        comment,
        final_score
        from cr_score
        where 1 = 1
        and room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
    </select>
    <select id="selectByRoomId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrScore">
        select *
        from cr_score
        where room_id = #{roomId}
    </select>

</mapper>
