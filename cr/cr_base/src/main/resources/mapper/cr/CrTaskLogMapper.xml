<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.CrTaskLogMapper">
    <select id="selectReleaseByRoomIdAndActionCodes" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTaskLog">
        select *
        from cr_task_log
        where room_id = #{roomId}
        and action_code in
        <foreach collection="actionCodes" item="actionCode" separator="," open="(" close=")">
            #{actionCode}
        </foreach>
    </select>
</mapper>