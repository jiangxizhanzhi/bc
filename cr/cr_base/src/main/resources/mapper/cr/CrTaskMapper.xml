<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.CrTaskMapper">

    <insert id="batchInsert" parameterType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        insert into cr_task
        (resource_id, `status`, mission_id, user_id,
        release_time, room_id, role_id, business_type, create_time, update_time)
        values
        <foreach collection="tasks" item="task" separator=",">
            (#{task.resourceId}, #{task.status}, #{task.missionId}, #{task.userId},
            #{task.releaseTime}, #{task.roomId},#{task.roleId}, #{task.businessType}, now(), now())
        </foreach>
    </insert>

    <select id="selectByUserIdAndMissionId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where mission_id = #{missionId}
          and user_id = #{userId}
    </select>

    <select id="selectByRoomIdAndUserId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where room_id = #{roomId}
          and user_id = #{userId}
    </select>

    <select id="countByRoomIdAndUserId" resultType="java.lang.Integer">
        select count(*)
        from cr_task
        where room_id = #{roomId}
          and user_id = #{userId}
    </select>

    <select id="selectByRoomIdAndStatusList" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where room_id = #{roomId}
        and status in
        <foreach collection="statusList" item="status" separator="," open="(" close=")">
            #{status}
        </foreach>
    </select>

    <select id="countByRoomIdAndStatusList" resultType="java.lang.Integer">
        select count(*)
        from cr_task
        where room_id = #{roomId}
        and status in
        <foreach collection="statusList" item="status" separator="," open="(" close=")">
            #{status}
        </foreach>
    </select>

    <select id="countByRoomIdAndUserIdAndStatusList" resultType="java.lang.Integer">
        select count(*)
        from cr_task
        where room_id = #{roomId}
        and user_id = #{userId}
        and status in
        <foreach collection="statusList" item="status" separator="," open="(" close=")">
            #{status}
        </foreach>
    </select>

    <select id="selectByRoomIdAndUserIdAndStatusList" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where room_id = #{roomId}
        and user_id = #{userId}
        and status in
        <foreach collection="statusList" item="status" separator="," open="(" close=")">
            #{status}
        </foreach>
    </select>

    <select id="selectByRoomId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where room_id = #{roomId}
    </select>

    <select id="selectByRole" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where role_id = #{roleId}
    </select>

    <select id="selectByRoles" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select * from cr_task where role_id in
        <foreach collection="roleIds" item="roleId" separator="," open="(" close=")">
            #{roleId}
        </foreach>
    </select>

    <select id="selectByRoomIdAndMissionIds" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select * from cr_task where room_id = #{roomId} and mission_id in
        <foreach collection="missionIds" item="missionId" separator="," open="(" close=")">
            #{missionId}
        </foreach>
    </select>

    <select id="selectReportedByUserIdsAndMissionIds" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select * from cr_task where room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
        and mission_id in
        <foreach collection="missionIds" item="missionId" separator="," open="(" close=")">
            #{missionId}
        </foreach>
        and report_time is not null
    </select>

    <select id="countUnreportedByRoomIdAndUserIds" resultType="java.lang.Integer">
        select count(*) from cr_task where room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
        and last_submit_time is null
    </select>

    <select id="selectByMissionId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where mission_id = #{missionId}
    </select>

    <select id="selectIdsByRoomIdAndUserIds" resultType="java.lang.String">
        select resource_id
        from cr_task
        where room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
    </select>

    <select id="selectIdsByRoomIdAndUserId" resultType="java.lang.String">
        select resource_id
        from cr_task
        where room_id = #{roomId}
          and user_id = #{userId}
    </select>

    <select id="selectByRoomIdAndUserIdsAndStatusList" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
        and status in
        <foreach collection="statusList" item="status" separator="," open="(" close=")">
            #{status}
        </foreach>
    </select>
    <select id="selectByRoomIdAndUserIds" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTask">
        select *
        from cr_task
        where room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
    </select>

</mapper>
