<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.CrTaskSubmitMapper">

    <select id="selectByRoomId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTaskSubmit">
        select *
        from cr_task_submit
        where room_id = #{roomId}
    </select>
    <select id="selectLastByTaskId" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTaskSubmit">
        select *
        from cr_task_submit
        where task_id = #{taskId}
        order by evaluate_time desc limit 1
    </select>

</mapper>