<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.CrTitleLevelMapper">
    <select id="list" resultType="com.cyberpeace.cr.crbase.dao.entity.CrTitleLevel">
        select * from cr_title_level
        <where>
            <if test="name != null and name != ''">
                <bind name="name" value="'%' + name + '%'"/>
                `name` like #{name}
            </if>
        </where>
        order by id desc
    </select>
</mapper>