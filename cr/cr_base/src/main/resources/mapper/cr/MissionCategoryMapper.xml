<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.MissionCategoryMapper">
    <select id="selectAll"
            resultType="com.cyberpeace.cr.crbase.dao.entity.MissionCategory">
        select *
        from cr_mission_category
    </select>

    <select id="selectByIds" resultType="com.cyberpeace.cr.crbase.dao.entity.MissionCategory">
        select *
        from cr_mission_category
        where resource_id in
        <foreach collection="missionsCategoryIds" item="resource_id" separator="," open="(" close=")">
            #{resource_id}
        </foreach>
    </select>

</mapper>
