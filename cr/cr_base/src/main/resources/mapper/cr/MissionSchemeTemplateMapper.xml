<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.MissionSchemeTemplateMapper">
    <select id="list" resultType="com.cyberpeace.cr.crbase.dao.entity.MissionSchemeTemplate">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select *
        from cr_mission_scheme_template
        <where>
            <if test="pattern != null and pattern != ''">
                title like #{pattern}
            </if>
        </where>
    </select>
</mapper>