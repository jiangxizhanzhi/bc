<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.MissionSkillEvaluationMapper">

    <resultMap id="base" type="com.cyberpeace.cr.crbase.dao.entity.MissionSkillEvaluation"/>

    <select id="selectLastOne" resultMap="base">
        select student_id, skill, score from cr_mission_skillevaluation
        where student_id = #{userId} and skill = #{skillId}
        order by create_time desc
        limit 0,1
    </select>

</mapper>
