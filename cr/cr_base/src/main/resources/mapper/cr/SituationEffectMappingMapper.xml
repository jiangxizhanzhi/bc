<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.SituationEffectMappingMapper">
    <select id="page" resultType="com.cyberpeace.cr.crbase.service.context.effect.SituationEffectBo">
        <if test="pattern != null and pattern != ''">
            <bind name="search" value="'%' + pattern + '%'"/>
        </if>

        select * from situation_effect_mapping
        <where>
            <if test="pattern != null and pattern != ''">
                name like #{search}
            </if>
        </where>
    </select>
    <select id="ifNameDuplicate" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from situation_effect_mapping where name = #{name}
        <if test="resourceId != null and resourceId != ''">
            and resource_id != #{resourceId}
        </if>
        )then 1
        else 0
        end
        as result
    </select>
</mapper>