<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.SituationGuideHisMapper">

    <select id="countByType" resultType="java.lang.Integer">
        select count(*) from situation_guide_scheme
        <where>
            <if test="roomId != null and roomId != ''">
                room_id = #{roomId}
            </if>
            <if test="type != null">
                and `type` = #{type}
            </if>
        </where>
    </select>

    <select id="countByCategory" resultType="com.cyberpeace.cr.crbase.service.context.guide.AttackTypeCountGroup">
        select category as category , count(*) as `count` from situation_guide_history
        <where>
            <if test="roomId != null and roomId != ''">
                room_id = #{roomId}
            </if>
            <if test="eventType != null">
                and `event_type` = #{eventType}
            </if>
            group by category
        </where>
    </select>

    <select id="getEventNameList" resultType="java.lang.String">
        select DISTINCT event_name
        from situation_guide_history
        <where>
            1=1
            <if test="roomId != null and roomId != ''">
                and room_id = #{roomId}
            </if>
            <if test="eventType != null">
                and event_type = #{eventType}
            </if>
        </where>
    </select>

    <select id="getEventByScreen" resultType="com.cyberpeace.cr.crbase.dao.entity.SituationGuideHistory">
        select *
        from situation_guide_history
        <where>
            1=1
            <if test="roomId != null and roomId != ''">
                and room_id = #{roomId}
            </if>
            <if test="typeList != null and typeList.size > 0">
                and `type` in
                <foreach collection="typeList" item="type" separator="," close=")" open="(">
                    #{type}
                </foreach>
            </if>
            <if test="eventType != null">
                and event_type = #{eventType}
            </if>
            <if test="startTime != null">
                and update_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                and update_time &lt; #{endTime}
            </if>
            <if test="eventName != null and eventName != ''">
                <bind name="eventName" value="'%' + eventName + '%'"/>
                and event_name like #{eventName}
            </if>
            <if test="category != null">
                and category = #{category}
            </if>
            <if test="sourceId != null and sourceId != ''">
                and `source` = #{sourceId}
            </if>
            <if test="targetId != null and targetId != ''">
                and target = #{targetId}
            </if>
            <if test="result != null">
                and `result` = #{result}
            </if>
            <if test="role != null">
                and `role` = #{role}
            </if>
        </where>
    </select>

    <select id="countByTime" resultType="com.cyberpeace.cr.crbase.service.context.guide.AttackTimeCountGroup">
        SELECT
        date_format(create_time, '%Y-%m-%d %H:00:00' ) createTime,
        COUNT(1) AS `count`
        FROM situation_guide_history
        WHERE  room_id = #{roomId}
        AND create_time  &gt;= #{startDate}
        GROUP BY createTime
    </select>

    <select id="getSceneIdsByRoom" resultType="java.lang.String">
        select scene_id_record from
        <if test="businessType == 3 ">
            cr_team_room
        </if>
        <if test="businessType == 4 ">
            cr_rb_room
        </if>
        <where>
            <if test="roomId != null and roomId != ''">
                resource_id = #{roomId}
            </if>
        </where>
    </select>

    <select id="getEventTimes" resultType="java.lang.String">
        select update_time from situation_guide_history
        <where>
            <if test="roomId != null and roomId != ''">
                room_id = #{roomId}
            </if>
        </where>
    </select>

    <select id="guideRecordListByTime" resultType="com.cyberpeace.cr.crbase.dao.entity.SituationGuideHistory">
        SELECT
        *
        FROM situation_guide_history
        WHERE  room_id = #{roomId}
        AND create_time  &gt;= #{startDate}
    </select>

    <select id="getTopoIdByRoom" resultType="java.lang.String">
        select copyed_topo_id from
        <if test="businessType == 3 ">
            cr_team_room
        </if>
        <if test="businessType == 4 ">
            cr_rb_room
        </if>
        <where>
            <if test="roomId != null and roomId != ''">
                resource_id = #{roomId}
            </if>
        </where>
    </select>
</mapper>