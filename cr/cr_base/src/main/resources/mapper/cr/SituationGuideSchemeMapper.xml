<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.SituationGuideSchemeMapper">

    <delete id="deleteBySceneId">
        delete
        from situation_dynamic_scheme
        where scene_id = #{sceneId}
    </delete>

    <select id="selectRoleConfigByBusinessType" resultType="com.cyberpeace.cr.crbase.service.context.guide.SituationGuideMissionBo">
        select a.resource_id roomId,b.business_template_id, b.role_config from
        <if test="businessType == 3 ">
            cr_team_room a JOIN cr_team_template b
            on a.team_template_id=b.resource_id
        </if>
        <if test="businessType == 4 ">
            cr_rb_room a JOIN cr_rb_template b
            on a.template_id=b.resource_id
        </if>
        WHERE a.resource_id = #{roomId}
    </select>

    <select id="selectRoomType" resultType="com.cyberpeace.cr.crbase.service.context.guide.SituationRoomBo">
        select resource_id roomId,local_scene_id from
        <if test="businessType == 3 ">
            cr_team_room
        </if>
        <if test="businessType == 4 ">
            cr_rb_room
        </if>
        WHERE resource_id = #{roomId}
    </select>
</mapper>