<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.TaskMapper">
    <select id="selectByMissionIdAndUserId" resultType="com.cyberpeace.cr.crbase.dao.entity.Task">
        select *
        from cr_task
        where mission_id = #{mission_id}
          and user_id = #{user_id}
    </select>

</mapper>
