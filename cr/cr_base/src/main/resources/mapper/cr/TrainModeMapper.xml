<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.cr.crbase.dao.mapper.TrainModeMapper">

    <select id="listBusinessTemplate" resultType="com.cyberpeace.cr.crbase.controller.rsp.TrainModeRsp">
        SELECT
        a.resource_id ,a.`name`,a.description, a.create_time , a.update_time,
        IF(a.business_type=3, case b.train_category when 1 then 2 when 2 then 3  when 3 then 6  else 999  end ,a.business_type ) type
        FROM
        cr_business_template a
        LEFT JOIN cr_team_template b
        ON a.resource_id=b.business_template_id
        <where>
            <if test="trainCategory != null and trainCategory.size() > 0">
                AND b.train_category IN
                <foreach collection="trainCategory" open="(" close=")" item="category" separator=",">
                    #{category}
                </foreach>
            </if>
            <if test="businessType != null and businessType.size() > 0">
                and a.business_type IN
                <foreach collection="businessType" open="(" close=")" item="type" separator=",">
                    #{type}
                </foreach>
            </if>
            <if test="name != null and name !=''">
                <bind name="pattern" value="'%' + name + '%'"/>
                AND NAME LIKE #{pattern}
            </if>
        </where>
        ORDER BY a.create_time DESC
    </select>

    <select id="listCourse" resultType="com.cyberpeace.cr.crbase.controller.rsp.TrainModeRsp">
        SELECT
        resource_id ,`name`, description, create_time ,update_time
        FROM
        oj_course
        <where>
            <if test="name != null and name !=''">
                <bind name="pattern" value="'%' + name + '%'"/>
                and name like #{pattern}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>