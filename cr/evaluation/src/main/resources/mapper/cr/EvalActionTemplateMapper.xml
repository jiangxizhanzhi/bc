<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalActionTemplateMapper">

    <select id="selectCountByRuleIds" resultType="com.cyberpeace.cr.evaluation.service.context.EvalRuleTemplateCount">
        select count(*) count, rule_id
        from cr_eval_action_template
        <where>
            <if test="ruleIds != null and ruleIds != ''">
                rule_id in
                <foreach collection="ruleIds" item="ruleId" separator="," close=")" open="(">
                    #{ruleId}
                </foreach>
            </if>
        </where>
    </select>

    <delete id="deleteByRuleIds">
        delete
        from cr_eval_action_template
        where rule_id in
        <foreach collection="ruleIds" item="ruleId" separator="," close=")" open="(">
            #{ruleId}
        </foreach>
    </delete>

    <select id="selectByRuleId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalActionTemplate">
        select *
        from cr_eval_action_template
        <where>
            <if test="ruleId != null and ruleId != ''">
                rule_id = #{ruleId}
            </if>
        </where>
    </select>

    <delete id="deleteByCloudTemplateIds">
        delete from cr_eval_action_template
        where cloud_template_id in
        <foreach collection="cloudTemplateIds" item="cloudId" separator="," open="(" close=")">
            #{cloudId}
        </foreach>
    </delete>

    <select id="selectByCloudTemplateId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalActionTemplate">
        select *
        from cr_eval_action_template
        where cloud_template_id = #{cloudTemplateId}
    </select>
</mapper>
