<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalAggregationMapper">


    <select id="selectIdsByEvalIndicatorIds" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalAggregation">
        select * from cr_eval_aggregation
        where eval_indicator_id in
        <foreach collection="evalIndicatorIds" open="(" close=")" separator="," item="evalIndicatorId">
            #{evalIndicatorId}
        </foreach>
    </select>
    <select id="selectAlgorithmNum" resultType="java.lang.Integer"
            parameterType="java.util.List">
        select count(1) from cr_eval_aggregation
        where aggregating_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>
</mapper>
