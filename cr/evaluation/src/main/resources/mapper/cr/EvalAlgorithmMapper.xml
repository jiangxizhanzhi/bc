<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalAlgorithmMapper">


    <update id="updateStateById" parameterType="java.lang.String">
        update `cr_eval_algorithm`
        set `state` = 1
        where `resource_id` = #{resourceId}
    </update>
    <select id="selectByType" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalAlgorithm"
            parameterType="java.lang.String">
        select *
        from `cr_eval_algorithm`

        where `type` = #{type}

    </select>

</mapper>
