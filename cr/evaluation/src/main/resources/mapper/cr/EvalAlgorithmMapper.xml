<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalAlgorithmMapper">


    <update id="updateStateById" parameterType="java.lang.String">
        update `cr_eval_algorithm`
        set `state` = 1
        where `resource_id` = #{resourceId}
    </update>

    <update id="updateStateByIds">
        update `cr_eval_algorithm`
        set `state` = 1
        where `resource_id` in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </update>
    <delete id="deleteAll">
        delete
        from cr_eval_algorithm
        where `state` = 0
        and `resource_id` in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>
    <delete id="deleteAllUnUsedBackup">
        delete
        from cr_eval_algorithm
        where `state` = 1
        and `resource_id` in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>

    <select id="selectByType" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalAlgorithm"
            parameterType="java.lang.String">
        select *
        from `cr_eval_algorithm`

        where `state` = 0
          and `type` = #{type}

    </select>

    <select id="listEvalAlgorithm" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalAlgorithm">
        <if test="listQuery.apply_type != null and listQuery.apply_type != ''">
            <bind name="search" value="'%' + listQuery.apply_type + '%'"/>
        </if>
        select * from cr_eval_algorithm
        <where>
            `state` = 0
            <if test="listQuery.name != null and listQuery.name != ''">
                <bind name="name" value="'%' + listQuery.name + '%'"/>
                and `name` like #{name}
            </if>
            <if test="listQuery.type != null and listQuery.type != ''">
                and `type` = #{listQuery.type}
            </if>
            <if test="listQuery.apply_type != null and listQuery.apply_type != ''">
                and `apply_type` like #{search}
            </if>
            <if test="listQuery.algorithm_language != null">
                and `algorithm_language` = #{listQuery.algorithm_language}
            </if>
        </where>
    </select>

    <select id="existByName" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_eval_algorithm
        where `state` = 0 and `name` = #{name}
        <if test="resourceId != null and resourceId != ''">
            and resource_id != #{resourceId}
        </if>)
        then 1
        else 0
        end
        as result;
    </select>
    <select id="getAll" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalAlgorithm">
        select *
        from cr_eval_algorithm
    </select>

</mapper>
