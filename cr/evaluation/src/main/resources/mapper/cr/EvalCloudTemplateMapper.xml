<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalCloudTemplateMapper">

    <select id="selectList" resultType="com.cyberpeace.cr.evaluation.service.context.EvalCloudTemplateListContext">
        select resource_id, `name`, target, type, create_user_id, topo_id
        from cr_eval_cloud_template
        <where>
            1 = 1
            <if test="name != null and name != ''">
                <bind name="pattern" value="'%' + name + '%'"/>
                and name like #{pattern}
            </if>
            <if test="type != null">
                and type = #{type}
            </if>
        </where>
        order by update_time desc
    </select>

    <select id="getTopoIdById" resultType="java.lang.String">
        select topo_id
        from cr_eval_cloud_template
        where resource_id = #{resourceId}
    </select>

    <select id="getTopoIdsByIds" resultType="java.lang.String">
        select topo_id
        from cr_eval_cloud_template
        where resource_id in
        <foreach collection="ids" open="(" separator="," close=")" item="id">
            #{id}
        </foreach>
    </select>

    <select id="templateList" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalCloudTemplate">
        select *
        from cr_eval_cloud_template
        <where>
            1=1
            <if test="listQuery.difficult != null">
                and difficulty = #{listQuery.difficult}
            </if>
            <if test="listQuery.type != null">
                and type = #{listQuery.type}
            </if>
            <if test="listQuery.pattern != null and listQuery.pattern != ''">
                <bind name="name" value="'%' + listQuery.pattern + '%'"/>
                and name like #{name}
            </if>
            order by update_time desc
        </where>
    </select>

    <select id="count" resultType="java.lang.Integer">
        select count(1)
        from cr_eval_cloud_template
    </select>
</mapper>
