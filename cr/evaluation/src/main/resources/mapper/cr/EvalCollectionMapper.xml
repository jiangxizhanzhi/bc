<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalCollectionMapper">


    <select id="selectIdsByEvalIndicatorIds" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalCollection">
        select * from cr_eval_collection
        where eval_indicator_id in
        <foreach collection="evalIndicatorIds" open="(" close=")" separator="," item="evalIndicatorId">
            #{evalIndicatorId}
        </foreach>
    </select>
    <select id="selectAlgorithmSum" resultType="java.lang.Integer"
            parameterType="java.util.List">
        select count(1) from cr_eval_collection
        where score_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        or detection_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        or format_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>
    <select id="selectUsedAlgorithmIds" resultType="java.lang.String">
        select score_algorithm_id from cr_eval_collection
        where score_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        union select detection_algorithm_id from cr_eval_collection
        where detection_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        union select format_algorithm_id from cr_eval_collection
        where format_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>
    <select id="selectBythirdIndexId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalCollection">
        select cr_eval_collection.*
        from cr_eval_collection,
             cr_eval_index
        where cr_eval_collection.eval_indicator_id = cr_eval_index.eval_indicator_id
          and cr_eval_index.resource_id = #{indexId}
    </select>
    <select id="selectByEvalIndicatorIds" resultType="com.cyberpeace.cr.evaluation.controller.rsp.EvalCollectionContextRsp">
        select * from cr_eval_collection
        where eval_indicator_id in
        <foreach collection="evalIndicatorIds" open="(" close=")" separator="," item="evalIndicatorId">
            #{evalIndicatorId}
        </foreach>
    </select>

    <select id="selectByEvalIndicators" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalCollection">
        select * from cr_eval_collection
        where eval_indicator_id in
        <foreach collection="evalIndicatorIds" open="(" close=")" separator="," item="evalIndicatorId">
            #{evalIndicatorId}
        </foreach>
    </select>

    <select id="getMaxId" resultType="java.lang.Integer">
        select max(id) from cr_eval_collection
    </select>
</mapper>
