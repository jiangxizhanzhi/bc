<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalCollectionMapper">


    <select id="selectIdsByEvalIndicatorIds" resultType="java.lang.String">
        select resource_id from cr_eval_collection
        where eval_indicator_id in
        <foreach collection="evalIndicatorIds" open="(" close=")" separator="," item="evalIndicatorId">
            #{evalIndicatorId}
        </foreach>
    </select>
</mapper>
