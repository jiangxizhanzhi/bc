<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalDimensionTemplateMapper">

    <select id="selectCountByRuleIds"
            resultType="com.cyberpeace.cr.evaluation.service.context.EvalRuleTemplateCount">
        select count(*) count, rule_id
        from cr_eval_dimension_template
        <where>
            rule_id in
            <foreach collection="ruleIds" item="ruleId" separator="," close=")" open="(">
                #{ruleId}
            </foreach>
        </where>
    </select>

    <delete id="deleteByRuleIds">
        delete from cr_eval_dimension_template
        where rule_id in
        <foreach collection="ruleIds" item="ruleId" separator="," close=")" open="(">
            #{ruleId}
        </foreach>
    </delete>

    <delete id="deleteByCloudTemplateIds">
        delete from cr_eval_dimension_template
        where rule_id in
        <foreach collection="cloudTemplateIds" item="cloudTemplateId" separator="," close=")" open="(">
            #{cloudTemplateId}
        </foreach>
    </delete>

    <select id="selectByRuleId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalDimensionTemplate">
        select *
        from cr_eval_dimension_template
        <where>
            <if test="ruleId != null and ruleId != ''">
                rule_id = #{ruleId}
            </if>
            order by create_time desc
        </where>
    </select>

    <select id="selectByCloudTemplateId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalDimensionTemplate">
        select *
        from cr_eval_dimension_template
        where cloud_template_id = #{cloudTemplateId}
    </select>
</mapper>
