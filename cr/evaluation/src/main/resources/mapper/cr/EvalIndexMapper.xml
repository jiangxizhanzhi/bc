<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalIndexMapper">

    <resultMap id="BaseResultMap" type="com.cyberpeace.cr.evaluation.dao.entity.EvalIndex">
        <id property="id" column="id" jdbcType="INTEGER"/>
        <result property="resourceId" column="resource_id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="description" column="description" jdbcType="VARCHAR"/>
        <result property="level" column="level" jdbcType="INTEGER"/>
        <result property="evalSystemId" column="eval_system_id" jdbcType="VARCHAR"/>
        <result property="type" column="type" jdbcType="INTEGER"/>
        <result property="aggregatingAlgorithmId" column="aggregating_algorithm_id" jdbcType="VARCHAR"/>
        <result property="aggregatingAlgorithmParams" column="aggregating_algorithm_params" jdbcType="VARCHAR"/>
        <result property="childrenIds" column="children_ids" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,resource_id,name,
        description,level,system_id,
        type,aggregating_algorithm_id,aggregating_algorithm_params,
        children_ids
    </sql>
    <delete id="deleteBatchByEvalSystemId" parameterType="java.lang.String">
        delete
        from cr_eval_index
        where eval_system_id = #{systemId}
    </delete>

    <select id="selectListBySystemIdAndLevel" resultMap="BaseResultMap">
        select *
        from cr_eval_index
        where eval_system_id = #{systemId}
        <if test="level != null and level != ''">
            and level = #{level}
        </if>
    </select>

    <select id="selectIdsByEvalSystemIds" resultType="java.lang.String">
        select resource_id from cr_eval_index
        where eval_system_id in
        <foreach collection="evalSystemIds" open="(" close=")" separator="," item="evalSystemId">
            #{evalSystemId}
        </foreach>
    </select>
    <select id="selectAlgorithmSum" resultType="java.lang.Integer"
            parameterType="java.util.List">
        select count(1) from cr_eval_index
        where aggregating_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>

    </select>
    <select id="existByName" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_eval_indicator
        where `name` = #{name}
        <if test="resourceId != null and resourceId != ''">
            and resource_id != #{resourceId}
        </if>
        )
        then 1
        else 0
        end
        as result;
    </select>
    <select id="selectUsedAlgorithmIds" resultType="java.lang.String">
        select aggregating_algorithm_id from cr_eval_index
        where aggregating_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>
</mapper>
