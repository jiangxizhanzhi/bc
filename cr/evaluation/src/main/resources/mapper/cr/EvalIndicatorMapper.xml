<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalIndicatorMapper">


<select id="selectAlgorithmSum" resultType="java.lang.Integer"
            parameterType="java.util.List">
        select count(1) from cr_eval_indicator
        where aggregating_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>
    <select id="listEvalIndicator" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalIndicator">
        select * from cr_eval_indicator
        <where>
            <if test="listQuery.name != null and listQuery.name != ''">
                <bind name="name" value="'%' + listQuery.name + '%'"/>
                name LIKE #{name}
            </if>
        </where>
    </select>
    <select id="existByName" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_eval_indicator
        where `name` = #{name}
        <if test="resourceId != null and resourceId != ''">
            and resource_id != #{resourceId}
        </if>)
        then 1
        else 0
        end
        as result;
    </select>
    <select id="selectUsedAlgorithmIds" resultType="java.lang.String">
        select aggregating_algorithm_id from cr_eval_indicator
        where aggregating_algorithm_id in
        <foreach collection="algorithmIds" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>
    <select id="selectIndexUsedNum" resultType="java.lang.Integer"
            parameterType="java.util.List">
        select count(1) from cr_eval_index
        where eval_indicator_id in
        <foreach collection="ids" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>

    <select id="selectIndexes" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalIndicator">
        select * from cr_eval_indicator
        where resource_id in
        <foreach collection="ids" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>
</mapper>
