<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalRecordMapper">

    <select id="pageList" resultType="com.cyberpeace.cr.evaluation.controller.rsp.EvalRecordListRsp">
        select
               T1.*,
               T2.name as system_name
        from cr_eval_record T1
        left join cr_eval_index_ref T2 on T1.resource_id = T2.record_id and T2.level = 1
        <where>
            T1.task_id = #{task_id}
            <if test="pattern != null and pattern != ''">
                <bind name="pattern" value="'%' + pattern + '%'"/>
                and T1.name like #{pattern}
            </if>
            <if test="status != null and status != ''">
                and T1.status = #{status}
            </if>
        </where>
        order by T1.id desc
    </select>

    <select id="seletTemplateById" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalRecord">


    </select>
</mapper>