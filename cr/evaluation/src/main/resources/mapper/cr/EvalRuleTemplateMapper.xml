<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalRuleTemplateMapper">

    <select id="selectAllByCloudTemplateId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalRuleTemplate">
        select *
        from cr_eval_rule_template
        <where>
            <if test="cloudTemplateId != null and cloudTemplateId != ''">
                cloud_template_id = #{cloudTemplateId}
            </if>
        </where>
    </select>

    <select id="listEvalRuleTemplate" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalRuleTemplate">
        select *
        from cr_eval_rule_template
        <where>
            1 = 1
            <if test="evalRuleTemplateListReq.cloudTemplateId != null and evalRuleTemplateListReq.cloudTemplateId != ''">
                and cloud_template_id = #{evalRuleTemplateListReq.cloudTemplateId}
            </if>
            <if test="evalRuleTemplateListReq.grade != null">
                and grade = #{evalRuleTemplateListReq.grade}
            </if>
            <if test="evalRuleTemplateListReq.status != null">
                and status = #{evalRuleTemplateListReq.status}
            </if>
            <if test="evalRuleTemplateListReq.pattern != null and evalRuleTemplateListReq.pattern != ''">
                <bind name="pattern" value="'%' + evalRuleTemplateListReq.pattern + '%'"/>
                and name like #{pattern}
            </if>
        </where>
    </select>

    <delete id="deleteByCloudTemplateIds">
        delete from cr_eval_rule_template
        where cloud_template_id in
        <foreach collection="cloudTemplateIds" item="cloudId" separator="," open="(" close=")">
            #{cloudId}
        </foreach>
    </delete>
</mapper>
