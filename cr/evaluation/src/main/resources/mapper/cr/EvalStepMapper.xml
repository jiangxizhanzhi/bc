<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalStepMapper">



    <select id="selectAllByTestId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalStep">
        select *
        from cr_eval_step
        where test_id = #{testId}
        order by stage
    </select>
</mapper>