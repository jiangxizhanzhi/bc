<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalStepTemplateMapper">

    <delete id="deleteByCloudTemplateIds">
        delete from cr_eval_step_template
        where cloud_template_id in
        <foreach collection="cloudTemplateIds" item="cloudId" separator="," open="(" close=")">
            #{cloudId}
        </foreach>
    </delete>

    <select id="selectStepByCloudTemplateId"
            resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalStepTemplate">
        select *
        from cr_eval_step_template
        where cloud_template_id = #{cloudTemplateId}
    </select>

    <select id="selectIdListByCloudTemplateId" resultType="java.lang.String">
        select step_ids
        from cr_eval_cloud_template
        where resource_id = #{cloudTemplateId}
    </select>

    <select id="select1ByCloudTemplateId" resultType="java.lang.Integer">
        select 1
        from cr_eval_step_template
        where cloud_template_id = #{cloudTemplateId}
        limit 1
    </select>

    <select id="selectRspByIds" resultType="com.cyberpeace.cr.evaluation.controller.rsp.EvalStepRsp">
        select resource_id step_id, `name`, process
        from cr_eval_step_template
        <where>
            <if test="ids != null and ids.size() != 0">
                resource_id in
                <foreach collection="ids" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
