<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalSystemMapper">

    <resultMap id="BaseResultMap" type="com.cyberpeace.cr.evaluation.dao.entity.EvalSystem">
        <id property="id" column="id" jdbcType="INTEGER"/>
        <result property="resourceId" column="resource_id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="description" column="description" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,resource_id,name,
        description
    </sql>

    <select id="listEvalSystems" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalSystem">
        select * from cr_eval_system
        <where>
            <if test="listQuery.name != null and listQuery.name != ''">
                <bind name="name" value="'%' + listQuery.name + '%'"/>
                name LIKE #{name}
            </if>

        </where>
    </select>
    <select id="existByName" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_eval_system
        where `name` = #{name}
        <if test="resourceId != null and resourceId != ''">
            and resource_id != #{resourceId}
        </if>
        )
        then 1
        else 0
        end
        as result;
    </select>

    <select id="selectByName" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalSystem">
        select * from cr_eval_system
       where name = #{name}
    </select>
</mapper>
