<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalTaskMapper">

    <resultMap id="evalTask" type="com.cyberpeace.cr.evaluation.dao.entity.EvalTask"/>

    <select id="selectResourceIdList" resultType="java.lang.String">
        select resource_id
        from cr_eval_task
        where template_id = #{templateId}
    </select>

</mapper>
