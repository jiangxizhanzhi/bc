<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalTaskMapper">

    <resultMap id="evalTask" type="com.cyberpeace.cr.evaluation.dao.entity.EvalTask"/>

    <select id="selectSlimTaskListByTemplateIdAndStatus" resultType="com.cyberpeace.cr.evaluation.service.context.EvalTaskSlimContext">
        select resource_id, task_name, mp_scene_id
        from cr_eval_task
        where template_id = #{templateId}
        <if test="status != null and status == @com.cyberpeace.cr.evaluation.dao.entity.EvalTask$Status@RUNNING.getCode()">
            and end_time is null
        </if>
        <if test="status != null and status == @com.cyberpeace.cr.evaluation.dao.entity.EvalTask$Status@FINISHED.getCode()">
            and end_time is not null
        </if>
    </select>

    <select id="selectIdsByTemplateIdAndStatus" resultType="java.lang.String">
        select resource_id
        from cr_eval_task
        where template_id = #{templateId}
        <if test="status != null and status == @com.cyberpeace.cr.evaluation.dao.entity.EvalTask$Status@RUNNING.getCode()">
            and end_time is null
        </if>
        <if test="status != null and status == @com.cyberpeace.cr.evaluation.dao.entity.EvalTask$Status@FINISHED.getCode()">
            and end_time is not null
        </if>
    </select>

    <select id="selectByIdAndStatus" resultMap="evalTask">
        select *
        from cr_eval_task
        where resource_id = #{taskId}
        <if test="status != null and status == @com.cyberpeace.cr.evaluation.dao.entity.EvalTask$Status@RUNNING.getCode()">
            and end_time is null
        </if>
        <if test="status != null and status == @com.cyberpeace.cr.evaluation.dao.entity.EvalTask$Status@FINISHED.getCode()">
            and end_time is not null
        </if>
    </select>

    <select id="getTemplateIdByTaskId" resultType="java.lang.String">
        select template_id
        from cr_eval_task
        where resource_id = #{taskId}
    </select>

    <select id="isNotFinished" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_eval_task
        where resource_id = #{taskId}
        and end_time is null)
        then 1
        else 0
        end
        as result;
    </select>

    <select id="existByNameAndTemplateId" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_eval_task
        where `task_name` = #{taskName}
        and template_id = #{templateId}
        <if test="taskId != null and taskId != ''">
            and resource_id != #{taskId}
        </if>)
        then 1
        else 0
        end
        as result;
    </select>

    <select id="getAllEvalSituation" resultType="com.cyberpeace.cr.evaluation.controller.rsp.EvalSituationListRsp">
        select template_name as name, resource_id as hash
        from cr_eval_task
        where end_time is null
    </select>
</mapper>
