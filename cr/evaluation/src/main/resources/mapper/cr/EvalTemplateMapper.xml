<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalTemplateMapper">

    <resultMap id="evalTemplate" type="com.cyberpeace.cr.evaluation.dao.entity.EvalTemplate"/>

    <select id="listEvalTemplates" resultMap="evalTemplate">

        select *
        from cr_eval_template
        <where>
            <if test="evalTemplateListQuery.categoryCode != null and evalTemplateListQuery.categoryCode != ''">
                and category_code = #{evalTemplateListQuery.categoryCode}
            </if>
            <if test="userId != null and userId != ''">
                <bind name="auth" value="'%' + userId + '%'"/>
                and (operation_auth_type = 1 or create_user_id = #{userId} or operation_auth_ids like #{auth})
            </if>
            <if test="evalTemplateListQuery.pattern != null and evalTemplateListQuery.pattern != ''">
                <bind name="pattern" value="'%' + evalTemplateListQuery.pattern + '%'"/>
                and name like #{pattern}
            </if>
            <if test="evalTemplateListQuery.type != null">
                and type = #{type}
            </if>
        </where>
    </select>

    <select id="existByNameAndUserIdAndId" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from cr_eval_template
        where `name` = #{templateName}
        and create_user_id = #{createUserId}
        <if test="templateId != null and templateId != ''">
            and resource_id != #{templateId}
        </if>)
        then 1
        else 0
        end
        as result;
    </select>
    <select id="selectByResourceId" resultType="com.cyberpeace.cr.evaluation.dao.entity.EvalTemplate">
        select * from cr_eval_template where resource_id = #{resourceId}
    </select>

</mapper>
