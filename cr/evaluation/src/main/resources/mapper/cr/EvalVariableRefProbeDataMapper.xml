<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.EvalVariableRefProbeDataMapper">

    <select id="selectVariableProbeDataResult"
            resultType="com.cyberpeace.cr.evaluation.service.context.EvalVariableRefProbeDataContext">
        select * from cr_eval_variable_ref_probe_data T1
        left join cr_eval_probe_data T2 on T1.probe_data_id = T2.resource_id
        <where>
            T1.variable_id = #{variable_id}
        </where>
    </select>
</mapper>