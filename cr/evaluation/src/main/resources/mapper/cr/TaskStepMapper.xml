<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.TaskStepMapper">

    <resultMap id="taskStep" type="com.cyberpeace.cr.evaluation.dao.entity.TaskStep"/>

    <select id="selectStepsByTaskId" resultMap="taskStep">
        select *
        from cr_eval_task_step
        where task_id = #{taskId}
    </select>

</mapper>
