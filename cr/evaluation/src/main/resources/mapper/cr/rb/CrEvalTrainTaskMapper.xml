<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.evaluation.dao.mapper.rb.CrEvalTrainTaskMapper">

    <select id="selectByUserIdAndMissionId" resultType="com.cyberpeace.cr.evaluation.dao.entity.rb.CrEvalTrainTask">
        select *
        from cr_task
        where mission_id = #{missionId}
        and user_id = #{userId}
    </select>

    <select id="selectByRoomId" resultType="com.cyberpeace.cr.evaluation.dao.entity.rb.CrEvalTrainTask">
        select *
        from cr_eval_tain_task
        where room_id = #{roomId}
    </select>

    <select id="selectByRoomIdAndUserIds" resultType="com.cyberpeace.cr.evaluation.dao.entity.rb.CrEvalTrainTask">
        select *
        from cr_eval_tain_task
        where room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
    </select>


    <select id="selectByRoomIdAndUserId" resultType="com.cyberpeace.cr.evaluation.dao.entity.rb.CrEvalTrainTask">
        select *
        from cr_eval_tain_task
        where room_id = #{roomId}
        and user_id = #{userId}
    </select>


    <select id="selectByRoomIdAndUserIdsAndStatusList" resultType="com.cyberpeace.cr.evaluation.dao.entity.rb.CrEvalTrainTask">
        select *
        from cr_task
        where room_id = #{roomId}
        and user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
        and status in
        <foreach collection="statusList" item="status" separator="," open="(" close=")">
            #{status}
        </foreach>
    </select>

</mapper>
