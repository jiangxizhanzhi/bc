<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.redvsblue.dao.mapper.RbRoomMapper">
    <select id="selectAll" resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbRoom">
        select *
        from cr_rb_room
    </select>
    <select id="countAll" resultType="java.lang.Integer">
        select count(`id`)
        from cr_rb_room
    </select>
</mapper>