<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.cr.redvsblue.dao.mapper.RbTemplateMapper">
    <select id="selectByBusinessTemplateId" resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbTemplate">
        select *
        from cr_rb_template
        where business_template_id = #{businessTemplateId}
    </select>
</mapper>