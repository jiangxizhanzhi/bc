<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.cr.redvsblue.dao.mapper.RbCombatLogMapper">

    <select id="selectOneByOriginalLog" resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbCombatLog">
        select *
        from cr_rb_combat_log
        <where>
            <if test="originalLog != null and originalLog != ''">
                <bind name="originalLog" value="'%' + originalLog + '%'"/>
                original_log like #{originalLog}
            </if>
        </where>
    </select>

    <select id="selectOneByRoomIdAndAgentIpAndIsLostHost"
            resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbCombatLog">
        select *
        from cr_rb_combat_log
        <where>
            <if test="roomId != null and roomId != ''">
                room_id = #{roomId}
            </if>
            <if test="agentIp != null and agentIp != ''">
                and agent_ip = #{agentIp}
            </if>
            <if test="isLostHost != null and isLostHost != ''">
                and is_lost_host = #{isLostHost}
            </if>
        </where>
    </select>

    <select id="selectByMainLogId"
            resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbCombatLog">
        select *
        from cr_rb_combat_log
        <where>
            <if test="mainLogId != null and mainLogId != ''">
                main_log_id = #{mainLogId}
                or resource_id = #{mainLogId}
            </if>
        </where>
    </select>
</mapper>