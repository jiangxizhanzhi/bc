<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.redvsblue.dao.mapper.RbCommonDeviceMapper">
    <select id="selectByCollectUserAndRoomId" resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbCommonDevice">
        SELECT
            id,
            resource_id resourceId,
            room_id roomId,
            device_id deviceId,
            collect_user_id collectUserId,
            create_user_id createUserId,
            create_time createTime
        FROM cr_rb_common_device
        WHERE room_id = #{roomId}
        AND collect_user_id = #{collectUserId}
    </select>

    <delete id="deleteByResourceId">
        DELETE FROM cr_rb_common_device WHERE resource_id = #{resourceId}
    </delete>
</mapper>
