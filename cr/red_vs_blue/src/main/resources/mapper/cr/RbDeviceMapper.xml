<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.redvsblue.dao.mapper.RbDeviceMapper">


    <sql id="Base_Column_List">
        id
        ,resource_id,room_id,
        device_id,create_user_id,create_time,
        update_time
    </sql>
    <delete id="deleteByRoomId">
        delete
        from cr_rb_device
        where room_id = #{roomId}
    </delete>
    <delete id="deleteByRoomIdAndUserIdAndDeviceId">
        delete
        from cr_rb_device
        where room_id = #{roomId}
          and create_user_id = #{userId}
          and device_id = #{deviceId}
    </delete>
    <select id="selectByRoomIdAndOptionalDevice" resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbDevice">
        select *
        from cr_rb_device
        where room_id = #{roomId}
        <if test="device != null and device != ''">
            and
            device_id = #{device}
        </if>
    </select>
    <select id="selectByRoomIdAndDeviceId" resultType="com.cyberpeace.cr.redvsblue.dao.entity.RbDevice">
        select *
        from cr_rb_device
        where room_id = #{roomId}
          and device_id = #{deviceId}
    </select>
</mapper>
