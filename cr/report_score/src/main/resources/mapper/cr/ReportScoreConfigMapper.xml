<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.report_score.dao.mapper.ReportScoreConfigMapper">


    <select id="getTypeConfigs"
            resultType="com.cyberpeace.cr.report_score.dao.entity.ReportScoreConfig">
        select * from cr_report_score_config
        where `type` = #{type}
    </select>
</mapper>