<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.report_score.dao.mapper.ReportScoreConfigMapper">

    <resultMap id="TypeConfig" type="com.cyberpeace.cr.report_score.dao.entity.ReportScoreConfig">
        <result property="type" column="type" />
        <result property="key" column="key" />
        <result property="value" column="value" />
    </resultMap>
    <insert id="insertReportScoreConfig">
        insert into cr_report_score_config  ( `type`, `key`, `value` )  values
        (#{type},  #{key},  #{value} )
    </insert>
    <update id="updateByTypeAndKey">
        update `cr_report_score_config`
        set `value` = #{value}
        where
            `key` = #{key}
            and `type` =  #{type}
    </update>
    <delete id="deleteByTypeAndKey">
        DELETE FROM  `cr_report_score_config` WHERE
        `key` = #{key}
        and `type` = #{type}
    </delete>

    <select id="getTypeConfigs"
            resultType="com.cyberpeace.cr.report_score.dao.entity.ReportScoreConfig">
        select * from cr_report_score_config
        where `type` = #{type}
    </select>

    <select id="getTypeConfig" resultMap="TypeConfig">
        select * from cr_report_score_config
        <where>
            <if test="type != null and type != ''">
                and `type` = #{type}
            </if>
            <if test="key != null and key != ''">
                and `key` = #{key}
            </if>
            <if test="value != null and value != ''">
                <bind name="value" value="'%'+value+'%'" />
                and `value` like #{value}
            </if>
        </where>
    </select>
</mapper>