<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.singletrain.dao.mapper.SingleTemplateMapper">
    <select id="getByBusinessId" resultType="com.cyberpeace.cr.singletrain.dao.entity.SingleTemplate">
        select *
        from cr_single_template
        <where>
            <if test="resource_id != null and resource_id != ''">
                business_template_id = #{resource_id}
            </if>
        </where>
    </select>
    <select id="batchGetByBusinessId" resultType="com.cyberpeace.cr.singletrain.dao.entity.SingleTemplate">
        select *
        from cr_single_template
        where business_template_id in <foreach collection="businessTemplateIds" separator="," open="(" close=")" item="business_template_id">#{business_template_id}</foreach>
    </select>
</mapper>