<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.teamtrain.dao.mapper.TeamScoreMapper">

    <resultMap id="BaseResultMap" type="com.cyberpeace.cr.teamtrain.dao.entity.TeamScore">
        <id property="resourceId" column="resource_id" jdbcType="VARCHAR"/>
        <result property="teamInstanceId" column="team_instance_id" jdbcType="VARCHAR"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR"/>
        <result property="trainingScore" column="training_score" jdbcType="VARCHAR"/>
        <result property="trainingPercentage" column="training_percentage" jdbcType="VARCHAR"/>
        <result property="skillPercentage" column="skill_percentage" jdbcType="VARCHAR"/>
        <result property="skillScore" column="skill_score" jdbcType="VARCHAR"/>
        <result property="comment" column="comment" jdbcType="VARCHAR"/>
        <result property="finalScore" column="final_score" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        resource_id
        ,team_instance_id,user_id,
        training_score,training_percentage,skill_percentage,
        skill_score,comment,final_score
    </sql>
    <select id="getByRoomIdAndUser" resultType="com.cyberpeace.cr.teamtrain.dao.entity.TeamScore">
        select resource_id,
               team_instance_id,
               user_id,
               training_score,
               training_percentage,
               skill_percentage,
               skill_score,
               comment,
               final_score
        from cr_team_score
        where 1 = 1
          and team_instance_id = {#RoomId}
          and user_id = {#userId}
    </select>
</mapper>
