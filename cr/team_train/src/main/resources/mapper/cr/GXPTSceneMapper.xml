<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.teamtrain.dao.mapper.GXPTSceneMapper">

    <update id="updateTeamRoomByResourceId">
        UPDATE cr_team_room
        <set>
            <if test="isSychronized != null">
                is_sychronized = #{isSychronized},
            </if>
            <if test="returnData != null">
                return_data = #{returnData},
            </if>
            <if test="returnInfo != null">
                return_info = #{returnInfo},
            </if>
        </set>
            WHERE resource_id = #{resourceId}
    </update>

    <update id="updateTeamRoomTopoByResourceId">
        UPDATE cr_team_room
        <set>
            <if test="isSychronized != null">
                is_sychronized_topology = #{isSychronized},
            </if>
            <if test="returnData != null">
                return_data_topology = #{returnData},
            </if>
            <if test="returnInfo != null">
                return_info_topology = #{returnInfo},
            </if>
        </set>
        WHERE resource_id = #{resourceId}
    </update>

</mapper>