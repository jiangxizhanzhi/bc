<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.cr.teamtrain.dao.mapper.LocalSceneMapper">

    <resultMap id="BaseResultMap" type="com.cyberpeace.cr.teamtrain.dao.entity.LocalScene">
        <id property="resourceId" column="resource_id" jdbcType="VARCHAR"/>
        <result property="mpSceneId" column="mp_scene_id" jdbcType="VARCHAR"/>
        <result property="businessType" column="business_type" jdbcType="VARCHAR"/>
        <result property="moduleType" column="module_type" jdbcType="VARCHAR"/>
        <result property="businessCode" column="business_code" jdbcType="VARCHAR"/>
        <result property="startTime" column="start_time" jdbcType="VARCHAR"/>
        <result property="destoryTime" column="destory_time" jdbcType="VARCHAR"/>
        <result property="destoryMode" column="destory_mode" jdbcType="VARCHAR"/>
        <result property="businessInstanceId" column="business_instance_id" jdbcType="VARCHAR"/>
        <result property="sceneStatus" column="scene_status" jdbcType="VARCHAR"/>
        <result property="pauseTime" column="pause_time" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        resource_id
        ,mp_scene_id,business_type,
        module_type,business_code,start_time,
        destory_time,destory_mode,business_instance_id,
        scene_status,pause_time
    </sql>
    <select id="getLocalSceneByBusinessInstanceId"
            resultType="com.cyberpeace.cr.teamtrain.dao.entity.LocalScene">
        select resource_id
                ,
               mp_scene_id,
               business_type,
               module_type,
               business_code,
               start_time,
               destory_time,
               destory_mode,
               business_instance_id,
               scene_status,
               pause_time
        from local_scene
        where business_instance_id = #{businessInstanceId}
    </select>
</mapper>
