<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.tool.dao.mapper.ToolCategoryMapper">

    <select id="list" resultType="com.cyberpeace.cr.tool.dao.entity.ToolCategory">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select * from cr_tool_toolcategory
        <where>
            <if test="null != pattern and pattern != ''">
                and (`cn_name` like #{pattern} or `en_name` like #{pattern})
            </if>
            <if test="null != type and type != ''">
                and `type` = #{type}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectByResourceIds" resultType="com.cyberpeace.cr.tool.dao.entity.ToolCategory">
        select * from cr_tool_toolcategory
        <where>
            <if test="null != ids and ids.size() > 0">
                and resource_id in
                <foreach collection="ids" separator="," open="(" close=")" item="cId">
                    #{cId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByIds" resultType="com.cyberpeace.cr.tool.dao.entity.ToolCategory">
        select * from cr_tool_toolcategory
        <where>
            <if test="null != ids and ids.size() > 0">
                and id in
                <foreach collection="ids" separator="," open="(" close=")" item="cId">
                    #{cId}
                </foreach>
            </if>
        </where>
    </select>
    <select id="getByCnName" resultType="com.cyberpeace.cr.tool.dao.entity.ToolCategory">
        select * from cr_tool_toolcategory
        <where>
            <if test="name != null and name != ''">
                and cn_name = #{name}
            </if>
            <if test="resourceId != null and resourceId != ''">
                and resource_id != #{resourceId}
            </if>
        </where>
    </select>

    <select id="getByType" resultType="com.cyberpeace.cr.tool.dao.entity.ToolCategory">
        select * from cr_tool_toolcategory
        <where>
            <if test="type != null and type != ''">
                and `type` = #{type}
            </if>
        </where>
    </select>

    <select id="getByEnName" resultType="com.cyberpeace.cr.tool.dao.entity.ToolCategory">
        select * from cr_tool_toolcategory
        <where>
            <if test="enName != null and enName != ''">
                and en_name = #{enName}
            </if>
            <if test="resourceId != null and resourceId != ''">
                and resource_id != #{resourceId}
            </if>
        </where>
    </select>
</mapper>
