<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.tool.dao.mapper.ToolFileMapper">

    <select id="selectByIds" resultType="com.cyberpeace.cr.tool.dao.entity.ToolFile">
        select * from cr_tool_toolfile
        <where>
            <if test="null != ids and ids.size() > 0">
                and id in
                <foreach collection="ids" separator="," open="(" close=")" item="fId">
                    #{fId}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
