<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.tool.dao.mapper.ToolMapper">
    <select id="list" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="isAdmin == false">
                and visible is true
            </if>
            <if test="listQuery.pattern != null and listQuery.pattern != ''">
                <bind name="pattern" value="'%' + listQuery.pattern + '%'"/>
                and `name` like #{pattern}
            </if>
            <if test="listQuery.category != null and listQuery.category != ''">
                <bind name="category" value="'%' + listQuery.category + '%'"/>
                and `category` like #{category}
            </if>
            <if test="listQuery.cracked != null">
                and `cracked` = #{listQuery.cracked}
            </if>
            <if test="listQuery.platforms != null and listQuery.platforms != ''">
                <bind name="platforms" value="'%' + listQuery.platforms + '%'"/>
                and `platforms` like #{platforms}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectByName" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
        </where>
    </select>

    <select id="selectByCategory" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="resourceId != null and resourceId != ''">
                <bind name="resourceId" value="'%' + resourceId + '%'"/>
                category like #{resourceId}
            </if>
        </where>
    </select>

    <select id="selectOtherByName" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
            <if test="resourceId != null and resourceId != ''">
                and resource_id != #{resourceId}
            </if>
        </where>
    </select>
    <select id="selectNameSortList" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="isAdmin == false">
                and visible is true
            </if>
            <if test="listQuery.pattern != null and listQuery.pattern != ''">
                <bind name="pattern" value="'%' + listQuery.pattern + '%'"/>
                and `name` like #{pattern}
            </if>
            <if test="listQuery.category != null and listQuery.category != ''">
                <bind name="category" value="'%' + listQuery.category + '%'"/>
                and `category` like #{category}
            </if>
            <if test="listQuery.cracked != null">
                and `cracked` = #{listQuery.cracked}
            </if>
            <if test="listQuery.platforms != null and listQuery.platforms != ''">
                <bind name="platforms" value="'%' + listQuery.platforms + '%'"/>
                and `platforms` like #{platforms}
            </if>
        </where>
        order by convert(`name` using gbk)
    </select>

</mapper>
