<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.tool.dao.mapper.ToolMapper">

    <select id="list" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select * from cr_tool_tool
        <where>
            and status = 1
            <if test="null != pattern and pattern != ''">
                and `name` like #{pattern}
            </if>
        </where>
        order by id desc
    </select>
</mapper>
