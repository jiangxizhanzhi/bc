<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.tool.dao.mapper.ToolMapper">
    <select id="list" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
             resource_id in
            <foreach collection="ids" index="index" separator="," item="courseId" open="(" close=")">
                #{courseId}
            </foreach>
            <if test="ids.size() == 0">
                ('')
            </if>
            <if test="isAdmin == false">
                and visible is true
            </if>
            <if test="listQuery.pattern != null and listQuery.pattern != ''">
                <bind name="pattern" value="'%' + listQuery.pattern + '%'"/>
                and `name` like #{pattern}
            </if>
            <if test="listQuery.category != null and listQuery.category != ''">
                <bind name="category" value="'%' + listQuery.category + '%'"/>
                and `category` like #{category}
            </if>
            <if test="listQuery.cracked != null">
                and `cracked` = #{listQuery.cracked}
            </if>
            <if test="listQuery.platforms != null and listQuery.platforms != ''">
                <bind name="platforms" value="'%' + listQuery.platforms + '%'"/>
                and `platforms` like #{platforms}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectByName" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
        </where>
    </select>

    <select id="selectByCategory" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="resourceId != null and resourceId != ''">
                <bind name="resourceId" value="'%' + resourceId + '%'"/>
                category like #{resourceId}
            </if>
        </where>
    </select>

    <select id="selectOtherByName" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
            <if test="resourceId != null and resourceId != ''">
                and resource_id != #{resourceId}
            </if>
        </where>
    </select>
    <select id="selectNameSortList" resultType="com.cyberpeace.cr.tool.dao.entity.Tool">
        select * from cr_tool_tool
        <where>
            <if test="isAdmin == false">
                and visible is true
            </if>
            <if test="listQuery.pattern != null and listQuery.pattern != ''">
                <bind name="pattern" value="'%' + listQuery.pattern + '%'"/>
                and `name` like #{pattern}
            </if>
            <if test="listQuery.category != null and listQuery.category != ''">
                <bind name="category" value="'%' + listQuery.category + '%'"/>
                and `category` like #{category}
            </if>
            <if test="listQuery.cracked != null">
                and `cracked` = #{listQuery.cracked}
            </if>
            <if test="listQuery.platforms != null and listQuery.platforms != ''">
                <bind name="platforms" value="'%' + listQuery.platforms + '%'"/>
                and `platforms` like #{platforms}
            </if>
        </where>
        order by convert(`name` using gbk)
    </select>


    <select id="selectByAuth" resultType="java.lang.String">
        select resource_id from cr_tool_tool
        <where>
            <if test="!authContext.isSuperAdmin">
                <choose>
                    <when test="authContext.isWeb">
                        <choose>
                            <when test="authContext.organization != null and authContext.organization != ''">
                                <bind name="likeOrganization" value="'%' + authContext.organization + '%'"/>
                                (create_user_id = #{authContext.userId} or (read_auth_ids like #{likeOrganization}
                                and read_auth_type = 2) or read_auth_type = 1)
                            </when>
                            <otherwise>
                                1!=1
                            </otherwise>
                        </choose>
                    </when>
                    <otherwise>
                        <bind name="likeUser" value="'%' + authContext.userId + '%'"/>
                        (create_user_id = #{authContext.userId} or (operation_auth_ids like #{likeUser}
                        and operation_auth_type = 2) or operation_auth_type = 1)
                    </otherwise>
                </choose>
            </if>
        </where>
    </select>
</mapper>
