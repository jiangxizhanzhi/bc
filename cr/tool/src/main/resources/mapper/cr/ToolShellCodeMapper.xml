<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.cr.tool.dao.mapper.ToolShellCodeMapper">

    <select id="list" resultType="com.cyberpeace.cr.tool.dao.entity.ToolShellCode">

        <if test="author != null and author != ''">
            <bind name="author" value="'%' + author + '%'"/>
        </if>

        select * from cr_tool_shellcode
        <where>
            and status = 1
            <if test="null != author and author != ''">
                and `author` like #{author}
            </if>
            <if test="null != edbVerified">
                and `edb_verified` = #{edbVerified}
            </if>
            <if test="null != platform and platform != ''">
                and `platform` = #{platform}
            </if>

        </where>
        order by id desc
    </select>
</mapper>
