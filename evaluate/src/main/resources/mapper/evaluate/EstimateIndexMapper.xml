<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.evaluate.dao.mapper.EstimateIndexMapper">

    <resultMap id="baseResultMap" type="com.cyberpeace.evaluate.dao.entity.EstimateIndex"/>

    <insert id="insert">
        insert into estimate_index
        (estimate_index_id, `name`, algorithm_id, estimate_scheme_id,
        create_time, update_time,params)
        values
        (#{estimateIndexId}, #{name}, #{algorithmId}, #{estimateSchemeId},
        now(), now(),#{params})
    </insert>

    <update id="update">
        update estimate_index
        set update_time = now()
        <if test="null != name">
            ,`name` = #{name}
        </if>
        <if test="null != algorithmId">
            ,algorithm_id = #{algorithmId}
        </if>
        <if test="null != estimateSchemeId">
            ,estimate_scheme_id = #{estimateSchemeId}
        </if>
        <if test="null != params">
            ,params = #{params}
        </if>
    </update>

    <select id="selectByScheme" resultMap="baseResultMap">
        select * from estimate_index
        where estimate_scheme_id = #{schemeId}
    </select>

    <delete id="batchDelete" parameterType="string">
        delete from estimate_index
        where estimate_index_id in
        <foreach collection="list" item="item" index="index" open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>

    <delete id="deleteByScheme" parameterType="string">
        delete from estimate_index
        where estimate_scheme_id = #{schemeId}
    </delete>

    <select id="selectById" resultType="com.cyberpeace.evaluate.dao.entity.EstimateIndex">
        select * from estimate_index
        where estimate_index_id = #{indexId}
    </select>
</mapper>