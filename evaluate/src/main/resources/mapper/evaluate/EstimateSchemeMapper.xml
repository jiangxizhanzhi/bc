<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.evaluate.dao.mapper.EstimateSchemeMapper">

    <resultMap id="baseResultMap" type="com.cyberpeace.evaluate.dao.entity.EstimateScheme"/>

    <insert id="insert">
        insert into estimate_scheme
        (estimate_scheme_id, `name`, `desc`, logo,
        create_time, update_time, content)
        values
        (#{estimateSchemeId}, #{name}, #{desc}, #{logo},
        now(), now(), #{content})
    </insert>

    <select id="selectList" resultMap="baseResultMap">
        select * from estimate_scheme
        order by update_time
    </select>

    <select id="selectById" resultMap="baseResultMap">
        select * from estimate_scheme
        where estimate_scheme_id = #{schemeId}
    </select>

    <select id="selectAllCount" resultType="integer">
        select count(id) from estimate_scheme
    </select>
    
    <update id="update">
        update estimate_scheme
        set gmt_nodified = now()
        <if test="null != name">
            ,`name` = #{name}
        </if>
        <if test="null != desc">
            ,`desc` = #{desc}
        </if>
        <if test="null != logo">
            ,logo = #{logo}
        </if>
        WHERE estimate_scheme_id = #{estimateSchemeId}
    </update>

    <delete id="delete">
        delete from estimate_scheme
        where estimate_scheme_id = #{schemeId}
    </delete>
</mapper>