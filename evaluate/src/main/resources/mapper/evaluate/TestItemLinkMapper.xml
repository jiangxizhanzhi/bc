<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.evaluate.dao.mapper.TestItemLinkMapper">
    <resultMap id="baseResultMap" type="com.cyberpeace.evaluate.dao.entity.TestItemLink"/>

    <insert id="insert">
        insert into test_item_link
        (scheme_id, item_id, idx, create_time, update_time)
        values
        (#{schemeId}, #{itemId}, #{idx}, now(), now())
    </insert>

    <select id="selectBySchemeId" resultMap="baseResultMap">
        select * from test_item_link
        where scheme_id = #{schemeId}
    </select>

    <delete id="deleteBySchemeId">
        delete from test_item_link
        where scheme_id = #{schemeId}
    </delete>
    
    <update id="update">
        update test_item_link
        set update_time  =now()
        <if test="null != itemId">
            ,item_id = #{itemId}
        </if>
        <if test="null != idx">
            ,idx = #{idx}
        </if>
        where scheme_id = #{schemeId}
    </update>
</mapper>