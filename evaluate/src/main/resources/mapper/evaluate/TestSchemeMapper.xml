<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.evaluate.dao.mapper.TestSchemeMapper">
    <resultMap id="baseResultMap" type="com.cyberpeace.evaluate.dao.entity.TestScheme"/>

    <insert id="insert">
        insert into test_scheme
        (test_scheme_id, scheme_name, scheme_desc, logo_id, create_time,
         update_time, content)
        values
        (#{testSchemeId}, #{schemeName}, #{schemeDesc}, #{logoId}, now(),
         now(), #{content});
    </insert>


    <select id="countAll" resultType="java.lang.Integer">
        select count(*) from test_scheme
    </select>

    <select id="selectBySchemeId" resultMap="baseResultMap">
        select * from test_scheme
        where test_scheme_id = #{testSchemeId}
    </select>

    <delete id="deleteBySchemeId">
        delete from test_scheme
        where test_scheme_id = #{testSchemeId}
    </delete>
    
    <update id="update">
        update test_scheme
        set update_time = now()
        <if test="null != schemeName">
            ,scheme_name = #{schemeName}
        </if>
        <if test="null != schemeDesc">
            ,scheme_desc = #{schemeDesc}
        </if>
        <if test="null != logoId">
            ,logo_id = #{logoId}
        </if>
        where test_scheme_id = #{testSchemeId}
    </update>
</mapper>