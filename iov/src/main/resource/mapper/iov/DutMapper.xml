<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.iov.dao.mapper.DutMapper">
    <select id="page" resultType="com.cyberpeace.iov.service.bo.dut.DutListBo">
        select * from iov_dut
        <if test="model != null">
            <where>
                model = #{model}
            </where>
        </if>
        <if test="area != null">
            <where>
                area = #{area}
            </where>
        </if>
        <if test="status != null">
            <where>
                status = #{status}
            </where>
        </if>
    </select>
    <select id="listByModelAndArea" resultType="com.cyberpeace.iov.service.bo.dut.DutListBo">
        select * from iov_dut
        where model = #{model} and area = #{area} and status=1 and enabled=1;
    </select>
</mapper>