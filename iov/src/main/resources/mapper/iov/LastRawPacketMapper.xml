<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.iov.dao.mapper.LastRawPacketMapper">
    <update id="updatePacket">
        update iov_last_raw_packet
        set `raw` = #{raw}
        where `type` = #{type}
    </update>
</mapper>