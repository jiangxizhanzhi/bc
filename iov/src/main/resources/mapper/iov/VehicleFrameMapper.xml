<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.iov.dao.mapper.VehicleFrameMapper">
    <select id="page" resultType="com.cyberpeace.iov.service.bo.frame.VehicleFrameListBo">
        select * from iov_frame
            <if test="pattern != null and pattern != ''">
                <bind name="search" value="'%'+ pattern + '%'"/>
                where `name` like #{search}
            </if>
    </select>
</mapper>