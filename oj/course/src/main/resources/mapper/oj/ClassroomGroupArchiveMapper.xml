<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.ClassroomGroupArchiveMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.ClassroomGroupArchive"/>

    <select id="selectByRoomAndName" resultMap="base">
        select * from oj_classroom_group_archive
        where classroom_id = #{roomId}
        and name = #{name}
    </select>

    <select id="selectByRoom" resultMap="base">
        select * from oj_classroom_group_archive
        where classroom_id = #{roomId}
    </select>
</mapper>
