<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.ClassroomGroupInfoMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.ClassroomGroupInfo"/>
    <update id="updateBatchDestroyDelayByIds">
        update oj_classroom_group_info set destroy_delay = #{destroyDelay}
        where resource_id in
        <foreach collection="resourceIdList" item="resourceId" open="(" close=")" separator=",">
            #{resourceId}
        </foreach>
    </update>

    <select id="selectByRoomAndUser" resultMap="base">
        <bind name="groupUser" value="'%' + userId + '%'"/>
        select * from oj_classroom_group_info
        where classroom_id = #{roomId}
        and group_user_ids like #{groupUser}
    </select>

    <select id="selectByRoom" resultMap="base">
        select *
        from oj_classroom_group_info
        where classroom_id = #{roomId}
    </select>

    <select id="selectLastGroupByRoom" resultType="java.lang.Integer">
        select group_no from oj_classroom_group_info
        where classroom_id = #{roomId}
        order by group_no desc
        limit 0,1
    </select>

    <delete id="deleteByRoom">
        delete from oj_classroom_group_info
        where classroom_id = #{roomId}
    </delete>
</mapper>
