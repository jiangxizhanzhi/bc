<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.ClassroomGroupInfoMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.ClassroomGroupInfo"/>

    <select id="selectByRoomAndUser" resultMap="base">
        <bind name="groupUser" value="'%' + userId + '%'"/>
        select * from oj_classroom_group_info
        where classroom_id = #{roomId}
        and group_user_ids like #{groupUser}
    </select>
</mapper>
