<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.ClassroomMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.Classroom"/>

    <sql id="baseFiled">
        select resource_id,
               `start_time`,
               `end_time`,
               course_id,
               lesson_id,
               organization_id,
               organization_ids,
               create_user_id
        from oj_classroom
    </sql>

    <select id="listByTime" resultMap="base">
        <include refid="baseFiled"/>
        <where>
            <if test="null != start">
                and start_time &gt; #{start}
            </if>
            <if test="null != end">
                and start_time &lt; #{end}
            </if>
        </where>
        order by start_time asc
    </select>

    <select id="listByTimeAndOrg" resultMap="base">
        select * from oj_classroom
        <where>
            start_time &gt;= #{start} and end_time &lt;= #{end}
            <if test="null != org and org.size() != 0">
                and organization in
                <foreach collection="org" item="id" separator="," open="(" close=")">
                    #{id}
                </foreach>
            </if>
            <if test="null != user">
                and createUser = #{user}
            </if>
        </where>
        order by start_time asc
    </select>

</mapper>
