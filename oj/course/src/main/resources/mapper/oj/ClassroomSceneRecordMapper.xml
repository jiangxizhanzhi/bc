<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.oj.course.dao.mapper.ClassroomSceneRecordMapper">
    <select id="selectByRoomAndUser" resultType="com.cyberpeace.oj.course.dao.entity.ClassroomSceneRecord">
        select *
        from oj_classroom_scene_record
        where classroom_id = #{classroomId}
          and user_id = #{userId}
    </select>
    <select id="selectByRoomAndUsers" resultType="com.cyberpeace.oj.course.dao.entity.ClassroomSceneRecord">
        select *
        from oj_classroom_scene_record
        where classroom_id = #{classroomId}
        and user_id in
        <foreach collection="userIds" item="userId" open="(" close=")" separator=",">
            #{userId}
        </foreach>
    </select>
</mapper>