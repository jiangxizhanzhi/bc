<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.ClassroomSignMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.ClassroomSign"/>

    <select id="selectByRoom" resultMap="base">
        select * from oj_classroom_sign
        where classroom_id= #{roomId}
    </select>

    <select id="selectByRoomAndUser" resultMap="base">
        select * from oj_classroom_sign
        where classroom_id= #{roomId}
        and user_id = #{userId}
    </select>
    <select id="selectByRoomsAndUsers" resultType="com.cyberpeace.oj.course.dao.entity.ClassroomSign">
        select * from oj_classroom_sign
        where classroom_id in
        <foreach collection="classroomIds" open="(" close=")" separator="," item="classroomId">
            #{classroomId}
        </foreach>
        and user_id in
        <foreach collection="userIds" open="(" close=")" separator="," item="userId">
            #{userId}
        </foreach>
    </select>
</mapper>
