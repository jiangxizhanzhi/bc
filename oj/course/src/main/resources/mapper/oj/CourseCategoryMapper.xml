<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseCategoryMapper">

    <resultMap id="category" type="com.cyberpeace.oj.course.dao.entity.CourseCategory"/>

    <select id="selectChildrenByCode" resultMap="category">
        <bind name="code" value="code + '%'"/>
        select * from oj_course_category where
        code like #{code}
    </select>

    <select id="selectFirstLevel" resultMap="category">
        select * from oj_course_category
        where resource_id = code
    </select>

    <select id="selectAll" resultMap="category">
        select * from oj_course_category
    </select>

    <select id="pageBySearch" resultMap="category">
        select * from oj_course_category
        <where>
            <if test="null != pattern">
                <bind name="pattern" value="'%' + pattern + '%'"/>
                and `name` like #{pattern}
            </if>
        </where>
    </select>

</mapper>
