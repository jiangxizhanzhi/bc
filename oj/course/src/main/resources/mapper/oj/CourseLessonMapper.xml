<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseLessonMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.CourseLesson"/>

    <select id="listByCourses" resultType="com.cyberpeace.oj.course.dao.entity.CourseLesson">
        select * from course_lesson
        <where>
            and course in
            <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
                #{courseId}
            </foreach>
            and pulic = 1
            and status = 1
        </where>
    </select>

</mapper>
