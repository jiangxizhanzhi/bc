<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseLessonMapper">

    <resultMap id="lesson" type="com.cyberpeace.oj.course.dao.entity.CourseLesson">
        <result property="isPublic" column="public"/>
    </resultMap>

    <select id="listByCourses" resultMap="lesson">
        select * from oj_course_lesson
        <where>
            and course_id in
            <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
                #{courseId}
            </foreach>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByCourse" resultMap="lesson">
        select * from oj_course_lesson
        <where>
            course_id = #{courseId}
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="pageByContext" resultMap="lesson">
        select * from oj_course_lesson
        <where>
            <if test="context.courseIds != null and context.courseIds.size() != 0">
                course_id in
                <foreach collection="context.courseIds" separator="," item="courseId" close=")" open="(">
                    #{courseId}
                </foreach>
            </if>
            <if test="context.type != null">
                and `type` = #{context.type}
            </if>
            <if test="context.pattern != null and context.pattern != ''">
                <bind name="context.pattern" value="'%' + context.pattern + '%'"/>
                and `name` like #{context.pattern}
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByPublic" resultMap="lesson">
        select * from oj_course_lesson
        where resource_id = #{resourceId}
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
    </select>

    <delete id="deleteByCourse">
        delete from oj_course_lesson
        where course_id in
        <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
            #{courseId}
        </foreach>
    </delete>

    <select id="selectIdsByCourse" resultType="java.lang.String">
        select resource_id from oj_course_lesson
        where course_id in
        <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
            #{courseId}
        </foreach>
    </select>

    <select id="selectByCourseAndName" resultType="java.lang.String">
        select resource_id from oj_course_lesson
        where course_id = #{courseId}
        and name = #{name}
    </select>

    <select id="selectCourseByCourseAndName" resultMap="lesson">
        select * from oj_course_lesson
        where course_id = #{courseId}
        and name = #{name}
    </select>
    <select id="selectMinIndex" resultType="java.lang.Integer">
        SELECT Min(`index`)  FROM `oj_lesson_config`
        <where>
            course_id = #{courseId}
        </where>
        and node_type = 2
    </select>
    <select id="selectChapterCount" resultType="java.lang.Integer">
        SELECT count(resource_id)  FROM `oj_lesson_config`
        <where>
            course_id = #{courseId}
        </where>
        and node_type = 1
    </select>
</mapper>
