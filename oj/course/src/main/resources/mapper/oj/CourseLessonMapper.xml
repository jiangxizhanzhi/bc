<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseLessonMapper">

    <resultMap id="lesson" type="com.cyberpeace.oj.course.dao.entity.CourseLesson">
        <result property="isPublic" column="public"/>
    </resultMap>
    <update id="updateShare">
        update oj_course_lesson set `shared` = #{shared} where resource_id in
        <foreach collection="ids" separator="," close=")" open="(" item="id">
            #{id}
        </foreach>
        and create_user_id = #{userId}
    </update>

    <select id="listByCourses" resultMap="lesson">
        select * from oj_course_lesson
        <where>
            and course_id in
            <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
                #{courseId}
            </foreach>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByCourse" resultMap="lesson">
        select * from oj_course_lesson
        <where>
            course_id = #{courseId}
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="pageByContext" resultMap="lesson">
        select * from oj_course_lesson
        <where>
            <if test="context.courseIds != null and context.courseIds.size() != 0">
                course_id in
                <foreach collection="context.courseIds" separator="," item="courseId" close=")" open="(">
                    #{courseId}
                </foreach>
            </if>
            <if test="type != null">
                and `type` = #{type}
            </if>
            <if test="context.pattern != null and context.pattern != ''">
                <bind name="context.pattern" value="'%' + context.pattern + '%'"/>
                and `name` like #{context.pattern}
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByPublic" resultMap="lesson">
        select * from oj_course_lesson
        where resource_id = #{resourceId}
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
    </select>

    <delete id="deleteByCourse">
        delete from oj_course_lesson
        where course_id in
        <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
            #{courseId}
        </foreach>
    </delete>

    <select id="selectIdsByCourse" resultType="java.lang.String">
        select resource_id from oj_course_lesson
        where course_id in
        <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
            #{courseId}
        </foreach>
    </select>

    <select id="selectByCourseAndName" resultType="java.lang.String">
        select resource_id from oj_course_lesson
        where course_id = #{courseId}
        and name = #{name}
    </select>

    <select id="selectCourseByCourseAndName" resultMap="lesson">
        select * from oj_course_lesson
        where course_id = #{courseId}
        and name = #{name}
    </select>

    <select id="selectMinIndex" resultType="java.lang.Integer">
        SELECT Min(`index`)  FROM `oj_lesson_config`
        <where>
            course_id = #{courseId}
        </where>
        and node_type = 2
    </select>

    <select id="selectChapterCount" resultType="java.lang.Integer">
        SELECT count(resource_id)  FROM `oj_lesson_config`
        <where>
            course_id = #{courseId}
        </where>
        and node_type = 1
    </select>
    <select id="pageShared" resultType="com.cyberpeace.oj.course.dao.entity.CourseLesson">
        select * from oj_course_lesson
        <where>
            `type` = 1 and `shared` = 1
            <if test="pattern != null and pattern != ''">
                <bind name="search" value="'%' + pattern + '%'"/>
                and `name` like #{search}
            </if>
            <if test="userIds != null and userIds.size() > 0">
                and create_user_id in
                <foreach collection="userIds" item="userId" open="(" close=")" separator=",">
                    #{userId}
                </foreach>
            </if>
        </where>
    </select>
    <select id="selectMyExp" resultType="java.lang.String">
        select resource_id
        from oj_course_lesson
        where `type` = 1
          and create_user_id = #{userId}
        order by id
    </select>
    <select id="pageMy" resultType="com.cyberpeace.oj.course.dao.entity.CourseLesson">
        select * from oj_course_lesson
        <where>
            `type` = 1
            <if test="myIds != null and myIds.size() > 0">
                and resource_id in
                <foreach collection="myIds" item="myId" open="(" close=")" separator=",">
                    #{myId}
                </foreach>
            </if>
        </where>
    </select>
    <select id="selectIdsByIds" resultType="java.lang.String">
        select resource_id from oj_course_lesson
        <where>
            `type` = 1
            and resource_id in
            <foreach collection="myIds" item="myId" open="(" close=")" separator=",">
                #{myId}
            </foreach>
        </where>
    </select>
    <select id="selectByIds" resultType="com.cyberpeace.oj.course.service.bo.AdminLessonListBo">
        select l.name, c.name as course_name, l.resource_id from oj_course_lesson l left join oj_course c on l.course_id
        = c.id
        where `type` = 1 and l.resource_id in
        <foreach collection="myIds" item="myId" open="(" close=")" separator=",">
            #{myId}
        </foreach>
    </select>
    <select id="selectExternal" resultType="com.cyberpeace.oj.course.dao.entity.CourseLesson">
        select * from oj_course_lesson
        where
        resource_id in
        <foreach collection="ids" separator="," open="(" close=")" item="id">
            #{id}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
    </select>
</mapper>
