<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseMapper">

    <resultMap id="baseResultMap" type="com.cyberpeace.oj.course.dao.entity.Course">
        <result property="isPublic" column="public"/>
    </resultMap>

    <select id="listByPage" resultMap="baseResultMap">
        select * from oj_course
        <where>
            <if test="null != courseIds and courseIds.size() > 0">
                and resource_id in
                <foreach collection="courseIds" index="index" separator="," item="courseId" open="(" close=")">
                    #{courseId}
                </foreach>
            </if>
            <if test="null != courseContext">
                <if test="null != courseContext.eBook">
                    and `course_type` = #{courseContext.eBook}
                </if>
                <if test="null != courseContext.difficulty">
                    and `difficulty` = #{courseContext.difficulty}
                </if>
                <if test="null != courseContext.directions and courseContext.directions.size() > 0">
                    and `category_id` in
                    <foreach collection="courseContext.directions" index="index" separator=","
                             item="direction" open="(" close=")">
                        #{direction}
                    </foreach>
                </if>
                <if test="null != courseContext.pattern and courseContext.pattern != ''">
                    <bind name="pattern" value="'%' + courseContext.pattern + '%'"/>
                    and `name` like #{pattern}
                </if>
            </if>
            <if test="null != isPublic and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="notDeleteIdsByIds" resultType="java.lang.String">
        select resource_id from oj_course
        <where>
            <if test="null != courseIds and courseIds.size() > 0">
                and resource_id in
                <foreach collection="courseIds" separator="," open="(" close=")" item="courseId">
                    #{courseId}
                </foreach>
            </if>
            and status = 1
        </where>
    </select>

    <select id="selectByAuth" resultType="java.lang.String">
        select resource_id from oj_course
        <where>
            <if test="!authContext.isSuperAdmin">
                <choose>
                    <when test="authContext.isWeb">
                        <choose>
                            <when test="authContext.organization != null and authContext.organization != ''">
                                <bind name="likeOrganization" value="'%' + authContext.organization + '%'"/>
                                (create_user_id = #{authContext.userId} or (read_auth_ids like #{likeOrganization}
                                and read_auth_type = 2) or read_auth_type = 1)
                            </when>
                            <otherwise>
                                1!=1
                            </otherwise>
                        </choose>
                    </when>
                    <otherwise>
                        <bind name="likeUser" value="'%' + authContext.userId + '%'"/>
                        (create_user_id = #{authContext.userId} or (operation_auth_ids like #{likeUser}
                        and operation_auth_type = 2) or operation_auth_type = 1)
                    </otherwise>
                </choose>
            </if>
        </where>
    </select>

    <select id="selectSpecial" resultType="java.lang.String">
        select resource_id from oj_course
        <where>
            <if test="null != courseIds and courseIds.size() > 0">
                resource_id in
                <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
                    #{courseId}
                </foreach>
            </if>
            <choose>
                <when test="specialContext.myCourse and specialContext.systemCourse and specialContext.shareCourse">
                    # 不进行条件过滤
                </when>
                <otherwise>
                    <if test="null != specialContext.myCourse">
                        <choose>
                            <when test="specialContext.myCourse">
                                and `create_user_id` = #{specialContext.userId}
                            </when>
                            <otherwise>
                                and `create_user_id` != #{specialContext.userId}
                            </otherwise>
                        </choose>
                    </if>
                    <if test="null != specialContext.systemCourse">
                        and `builtin` = #{specialContext.systemCourse}
                    </if>
                    <if test="null != specialContext.shareCourse">
                        <choose>
                            <when test="specialContext.shareCourse">
                                <bind name="specialContext.likeUser" value="'%' + specialContext.userId + '%'"/>
                                and (`operation_auth_type` = 1 or (`operation_auth_type` = 2 and `operation_auth_ids` like
                                #{specialContext.likeUser}))
                            </when>
                            <otherwise>
                                <bind name="specialContext.likeUser" value="'%' + specialContext.userId + '%'"/>
                                and (`operation_auth_type` = 2 and `operation_auth_ids` not like
                                #{specialContext.likeUser})
                            </otherwise>
                        </choose>
                    </if>
                </otherwise>
            </choose>
        </where>
    </select>

    <select id="selectIdsByCategory" resultType="string">
        select resource_id from oj_course
        <where>
            <if test="courseIds != null and courseIds.size() != 0">
                resource_id in
                <foreach collection="courseIds" open="(" close=")" separator="," item="courseId">
                    #{courseId}
                </foreach>
            </if>
            <if test="categoryIds != null and categoryIds.size() != 0">
                and category_id in
                <foreach collection="categoryIds" open="(" close=")" item="categoryId" separator=",">
                    #{categoryId}
                </foreach>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

</mapper>
