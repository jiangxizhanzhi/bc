<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseMapper">

    <resultMap id="baseResultMap" type="com.cyberpeace.oj.course.dao.entity.Course"/>
    <sql id="share_constant">
        <bind name="ALL_SHARE_MODE" value="@com.cyberpeace.oj.course.dao.entity.Course@ALL_SHARE_MODE"/>
        <bind name="CUSTOM_SHARE_MODE" value="@com.cyberpeace.oj.course.dao.entity.Course@CUSTOM_SHARE_MODE"/>
    </sql>


    <sql id="auth">
        <include refid="share_constant"/>
        select resource_id from course_course
        <where>
            <choose>
                <when test="authContext.isWeb">
                    <if test="authContext.organization != null and authContext.organization != ''">
                        <bind name="authContext.organization" value="'%' + authContext.organization + '%'"/>
                    </if>
                    and (create_user = #{authContext.userId} or (auth_organization like #{authContext.organization}
                    and auth = ${CUSTOM_SHARE_MODE}) or auth = ${ALL_SHARE_MODE})
                </when>
                <otherwise>
                    <if test="authContext.likeUser != null and authContext.likeUser != ''">
                        <bind name="authContext.likeUser" value="'%' + authContext.likeUser + '%'"/>
                    </if>
                    (create_user = #{authContext.userId} or (share_teachers like #{authContext.likeUser}
                    and auth = ${CUSTOM_SHARE_MODE}) or auth = ${ALL_SHARE_MODE})
                </otherwise>
            </choose>
        </where>
    </sql>

    <sql id="courseIds">
        <foreach collection="courseIds" index="index" separator="," item="courseId" open="(" close=")">
            #{courseId}
        </foreach>
    </sql>

    <sql id="directions">
        <foreach collection="courseContext.directions" index="index" separator="," item="direction" open="(" close=")">
            #{direction}
        </foreach>
    </sql>

    <sql id="courseCondition">
        <if test="null != courseContext.eBook">
            and `e_book` = #{courseContext.eBook}
        </if>
        <if test="null != courseContext.difficulty">
            <bind name="courseContext.difficulty" value="courseContext.difficulty"/>
            and `difficulty` = #{courseContext.difficulty}
        </if>
        <if test="null != courseContext.directions and courseContext.directions.size() > 0">
            and `direction` in <include refid="directions"/>
        </if>
        <if test="null != courseContext.pattern and courseContext.pattern != ''">
            and `name` like #{courseContext.pattern}
        </if>
        <if test="null != courseContext.isPublic">
            and `public` = #{courseContext.isPublic}
        </if>
        <choose>
            <when test="courseContext.myCourse and courseContext.systemCourse and courseContext.shareCourse">
                # 不进行条件过滤
            </when>
            <otherwise>
                <if test="null != courseContext.myCourse">
                    <choose>
                        <when test="courseContext.myCourse">
                            and `create_user` = #{courseContext.userId}
                        </when>
                        <otherwise>
                            and `create_user` != #{courseContext.userId}
                        </otherwise>
                    </choose>
                </if>
                <if test="null != courseContext.systemCourse">
                    and `builtin` = #{courseContext.systemCourse}
                </if>
                <if test="null != courseContext.shareCourse">
                    <include refid="share_constant"/>
                    <bind name="courseContext.likeUser" value="'%' + courseContext.userId + '%'"/>
                    <choose>
                        <when test="courseContext.shareCourse">
                            and (`share` = ${ALL_SHARE_MODE} or (`share` = ${CUSTOM_SHARE_MODE} and `share_teachers` like
                            #{courseContext.likeUser}))
                        </when>
                        <otherwise>
                            and (`share` = ${CUSTOM_SHARE_MODE} and `share_teachers` not like
                            #{courseContext.likeUser})
                        </otherwise>
                    </choose>
                </if>
            </otherwise>
        </choose>
    </sql>

    <select id="selectByCourse" resultType="com.cyberpeace.oj.course.dao.entity.Course">
        select *
        from course_course
        where resource_id = #{courseId}
          and status = 1
    </select>

    <select id="listByPage" resultMap="baseResultMap">
        <if test="courseContext.pattern != null and courseContext.pattern != ''">
            <bind name="courseContext.pattern" value="'%' + courseContext.pattern + '%'"/>
        </if>

        select * from course_course
        <where>
            <if test="null != courseIds and courseIds.size() > 0">
                and resource_id in
                <include refid="courseIds"/>
            </if>
            <if test="null != courseContext">
                <include refid="courseCondition"/>
            </if>
            and status = 1
        </where>
    </select>

    <select id="notDeleteIdsByIds" resultType="java.lang.String">
        select resource_id from course_course
        <where>
            <if test="null != courseIds and courseIds.size() > 0">
                and resource_id in
                <foreach collection="courseIds" separator="," open="(" close=")" item="courseId">
                    #{courseId}
                </foreach>
            </if>
            and status = 1
        </where>
    </select>

    <select id="selectByAuth" resultType="java.lang.String">
        <include refid="auth"/>
    </select>

</mapper>
