<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseMapper">

    <resultMap id="baseResultMap" type="com.cyberpeace.oj.course.dao.entity.Course">
        <result property="isPublic" column="public"/>
    </resultMap>

    <update id="updateCourseHeat">
        update oj_course
        <set>
            heat = #{heat},
            update_time = update_time
        </set>
        <where>
            resource_id = #{resourceId}
        </where>
    </update>

    <select id="listByPage" resultMap="baseResultMap">
        select L1.*, count(L2.course_id) as lesson_count from oj_course L1
        left join oj_course_lesson L2 on L2.course_id = L1.resource_id
        <where>
            <if test="null != courseIds and courseIds.size() > 0">
                and L1.resource_id in
                <foreach collection="courseIds" index="index" separator="," item="courseId" open="(" close=")">
                    #{courseId}
                </foreach>
            </if>
            <if test="null != courseContext">
                <if test="null != courseContext.eBook">
                    and L1.course_type = #{courseContext.eBook}
                </if>
                <if test="null != courseContext.difficulty">
                    and L1.difficulty = #{courseContext.difficulty}
                </if>
                <if test="null != courseContext.directions and courseContext.directions.size() > 0">
                    and L1.category_id in
                    <foreach collection="courseContext.directions" index="index" separator=","
                             item="direction" open="(" close=")">
                        #{direction}
                    </foreach>
                </if>
                <if test="null != courseContext.pattern and courseContext.pattern != ''">
                    <bind name="pattern" value="'%' + courseContext.pattern + '%'"/>
                    and L1.name like #{pattern}
                </if>
            </if>
            <if test="null != isPublic and isPublic">
                and L1.`public` = #{isPublic}
            </if>
        </where>
        group by L1.resource_id
    </select>

    <select id="notDeleteIdsByIds" resultType="java.lang.String">
        select resource_id from oj_course
        <where>
            <if test="null != courseIds and courseIds.size() > 0">
                and resource_id in
                <foreach collection="courseIds" separator="," open="(" close=")" item="courseId">
                    #{courseId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByAuth" resultType="java.lang.String">
        select resource_id from oj_course
        <where>
            <if test="!authContext.isSuperAdmin">
                <choose>
                    <when test="authContext.isWeb">
                        <choose>
                            <when test="authContext.organization != null and authContext.organization != ''">
                                <bind name="likeOrganization" value="'%' + authContext.organization + '%'"/>
                                (create_user_id = #{authContext.userId} or (read_auth_ids like #{likeOrganization}
                                and read_auth_type = 2) or read_auth_type = 1)
                            </when>
                            <otherwise>
                                1!=1
                            </otherwise>
                        </choose>
                    </when>
                    <otherwise>
                        <bind name="likeUser" value="'%' + authContext.userId + '%'"/>
                        (create_user_id = #{authContext.userId} or (operation_auth_ids like #{likeUser}
                        and operation_auth_type = 2) or operation_auth_type = 1)
                    </otherwise>
                </choose>
            </if>
        </where>
    </select>

    <select id="selectSpecial" resultType="java.lang.String">
        select resource_id from oj_course
        <where>
            <if test="specialContext.myCourse">
                (resource_id in
                <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
                    #{courseId}
                </foreach>
                and `create_user_id` = #{specialContext.userId})
            </if>
            <if test="specialContext.systemCourse">
                or (resource_id in
                <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
                    #{courseId}
                </foreach>
                and `builtin` = #{specialContext.systemCourse})
            </if>
            <if test="specialContext.shareCourse">
                <bind name="likeUser" value="'%' + specialContext.userId + '%'"/>
                or (resource_id in
                <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
                    #{courseId}
                </foreach>
                and (`operation_auth_type` = 1 or (`operation_auth_type` = 2 and `operation_auth_ids` like
                #{likeUser})))
            </if>
        </where>
    </select>

    <select id="selectIdsByCategory" resultType="string">
        select resource_id from oj_course
        <where>
            <if test="courseIds != null and courseIds.size() != 0">
                resource_id in
                <foreach collection="courseIds" open="(" close=")" separator="," item="courseId">
                    #{courseId}
                </foreach>
            </if>
            <if test="categoryIds != null and categoryIds.size() != 0">
                and category_id in
                <foreach collection="categoryIds" open="(" close=")" item="categoryId" separator=",">
                    #{categoryId}
                </foreach>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByName" resultType="java.lang.String">
        select resource_id
        from oj_course
        where `name` = #{name}
    </select>

    <select id="selectByCourseNum" resultMap="baseResultMap">
        select *
        from oj_course
        where `course_num` = #{courseNum}
    </select>


    <select id="selectIdsByCourseName" resultType="com.cyberpeace.oj.course.dao.entity.Course">
        select resource_id, name from oj_course
        where `name` in
        <foreach collection="courseNames" item="courseName" open="(" close=")" separator=",">
            #{courseName}
        </foreach>
    </select>

    <select id="selectCourseByUserId" resultType="com.cyberpeace.oj.course.dao.entity.Course">
        select * from oj_course
        <where>
            <bind name="likeUser" value="'%' + userId + '%'"/>
            operation_auth_ids like #{likeUser}
        </where>
    </select>

    <select id="selectCourseByOrgId" resultType="com.cyberpeace.oj.course.dao.entity.Course">
        select * from oj_course
        <where>
            <bind name="likeOrganization" value="'%' + orgId + '%'"/>
            read_auth_ids like #{likeOrganization}
        </where>
    </select>
    <select id="selectWebCourseIds" resultType="java.lang.String">
        select distinct l.course_id
        from oj_course_lesson l
        inner join oj_course c on l.course_id = c.resource_id
        where l.`public` = 1
        and c.`public` = 1
        and l.course_id in
        <foreach item="courseId" collection="courseIds" separator="," open="(" close=")">
            #{courseId}
        </foreach>
    </select>
</mapper>
