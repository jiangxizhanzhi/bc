<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.CourseStudyHistoryMapper">

    <select id="selectByUserId" resultType="com.cyberpeace.oj.course.dao.entity.CourseStudyHistory">
        select *
        from oj_course_study_history
        <where>
            <if test="userId != null and userId != ''">
                user_id = #{userId}
            </if>
        </where>
        order by update_time desc
    </select>

    <select id="selectByCourseIdAndUserId" resultType="com.cyberpeace.oj.course.dao.entity.CourseStudyHistory">
        select *
        from oj_course_study_history
        <where>
            <if test="courseId != null and courseId != ''">
                course_id = #{courseId}
            </if>
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
        </where>
    </select>
</mapper>