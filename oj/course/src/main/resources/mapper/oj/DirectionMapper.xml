<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.DirectionMapper">

    <resultMap id="oj_direction" type="com.cyberpeace.oj.course.dao.oj_entity.Direction"/>

    <select id="selectByResource" resultType="com.cyberpeace.oj.course.dao.entity.CourseDirection">
        select * from course_direction where resource_id = #{direction}
    </select>

    <select id="selectChirdlentByCode" resultMap="oj_direction">
        <bind name="directionId" value="directionId + '%'"/>
        select * from course_direction where
        code like #{directionId}
    </select>

</mapper>
