<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonCheckPointAnswerMapper">
    <select id="selectByLessonAndUserAndTime"
            resultType="com.cyberpeace.oj.course.dao.entity.LessonCheckPointAnswer">
        select *
        from oj_check_point_answer
        where lesson_id = #{lessonId}
          and user_id = #{userId}
          and `time` = #{time}
    </select>
    <select id="selectByLessonAndUser" resultType="com.cyberpeace.oj.course.dao.entity.LessonCheckPointAnswer">
        select *
        from oj_check_point_answer
        where lesson_id = #{lessonId}
          and user_id = #{userId}
    </select>
</mapper>