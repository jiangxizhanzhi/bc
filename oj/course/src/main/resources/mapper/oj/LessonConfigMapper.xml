<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonConfigMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.LessonConfig"/>

    <select id="getFirstNode" resultMap="base">
        select * from oj_lesson_config
        where course_id = #{courseId} and parent_id is null
    </select>

    <select id="listByParent" resultMap="base">
        select * from oj_lesson_config
        where parent_id = #{parentId}
        order by `index` asc
    </select>

    <select id="selectByCourse" resultMap="base">
        select * from oj_lesson_config
        where course_id = #{courseId}
        order by `index` asc
    </select>

    <select id="selectLastByParent" resultMap="base">
        select * from oj_lesson_config
        where course_id = #{courseId}
        order by `index` desc
        limit 0, 1
    </select>

    <delete id="deleteByLessonIds">
        <if test="lessonIds != null and lessonIds.size() != 0">
            delete from oj_lesson_config
            <where>
                lesson_id in
                <foreach collection="lessonIds" item="lessonId" close=")" open="(" separator=",">
                    #{lessonId}
                </foreach>
            </where>
        </if>
    </delete>

    <select id="selectByLessonIds" resultMap="base">
        select * from oj_lesson_config
        <where>
            course_id = #{courseId}
            <if test="lessonIds != null and lessonIds.size() != 0">
                and lesson_id in
                <foreach collection="lessonIds" separator="," open="(" close=")" item="lessonId">
                    #{lessonId}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
