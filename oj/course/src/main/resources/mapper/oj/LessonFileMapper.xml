<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonFileMapper">

    <resultMap id="baseMap" type="com.cyberpeace.oj.course.dao.entity.LessonFile"/>

    <select id="listByLesson" resultMap="baseMap">
        select * from course_lessonfile
        where lesson = #{lessonId}
    </select>

</mapper>
