<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonMapper">

    <resultMap id="base" type="com.cyberpeace.oj.course.dao.entity.CourseLesson"/>

    <select id="pageByContext" resultMap="base">
        select * from course_lesson
        <where>
            <if test="null != context">
                <if test="null != context.courseId">
                    and  course = #{context.courseId}
                </if>
                <if test="null != context.type">
                    and `type` = #{context.type}
                </if>
                <if test="null != context.pattern and context.pattern != ''">
                    <bind name="context.pattern" value="'%' + context.pattern + '%'"/>
                    and `name` like #{context.pattern}
                </if>
            </if>
        </where>
    </select>

    <select id="selectByCourse" resultMap="base">
        select * from course_lesson
        <where>
            <if test="null != courseId">
                and course = #{courseId}
            </if>
        </where>
    </select>

</mapper>
