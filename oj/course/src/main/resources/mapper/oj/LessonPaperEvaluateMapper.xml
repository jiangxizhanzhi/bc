<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonPaperEvaluateMapper">

    <resultMap id="paperEvaluate" type="com.cyberpeace.oj.course.dao.entity.LessonPaperEvaluate"/>

    <select id="selectByUserAndLesson" resultMap="paperEvaluate">
        select * from oj_lesson_paper_evaluate
        where submit_user_id = #{userId}
        and lesson_id = #{lessonId}
    </select>
</mapper>
