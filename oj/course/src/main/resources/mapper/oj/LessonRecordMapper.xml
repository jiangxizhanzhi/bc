<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonRecordMapper">

    <resultMap id="baseResultMap" type="com.cyberpeace.oj.course.dao.entity.LessonRecord"/>

    <select id="selectByUser" resultType="com.cyberpeace.oj.course.dao.entity.LessonRecord">
        select * from oj_lesson_record
        <where>
            <if test="null != userId and userId != ''">
                user_id = #{userId}
            </if>
        </where>
    </select>

    <select id="listByLessonAndUser" resultType="com.cyberpeace.oj.course.dao.entity.LessonRecord">
        select * from oj_lesson_record
        <where>
            <if test="null != userId and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="null != lessonIds and lessonIds.size > 0">
                and lesson_id in
                <foreach collection="lessonIds" open="(" close=")" item="lessonId" separator=",">
                    #{lessonId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByTime" resultMap="baseResultMap">
        select * from oj_lesson_record
        <where>
            <if test="null != userId and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="null != start">
                and crete_time &gt; #{start}
            </if>
            <if test="null != end">
                and crete_time &lt; #{end}
            </if>
        </where>
        order by crete_time asc
    </select>

    <select id="selectByLessonAndUser" resultMap="baseResultMap">
        select * from oj_lesson_record
        <where>
            and `user_id` = #{userId}
            and lesson_id = #{lessonId}
        </where>
    </select>

    <insert id="save">
        insert into oj_lesson_record(lesson_id, user_id, course_id, create_time, update_time)
        values (#{lessonId}, #{userId}, #{courseId}, now(), now())
    </insert>

</mapper>
