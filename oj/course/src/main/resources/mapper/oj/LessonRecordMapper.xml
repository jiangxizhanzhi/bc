<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.course.dao.mapper.LessonRecordMapper">

    <resultMap id="baseResultMap" type="com.cyberpeace.oj.course.dao.entity.LessonRecord"/>

    <select id="selectByUser" resultType="com.cyberpeace.oj.course.dao.entity.LessonRecord">
        select * from oj_lesson_record
        <where>
            <if test="null != userId and userId != ''">
                user_id = #{userId}
            </if>
        </where>
    </select>

    <select id="listByLessonAndUser" resultType="com.cyberpeace.oj.course.dao.entity.LessonRecord">
        select * from oj_lesson_record
        <where>
            <if test="null != userId and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="null != lessonIds and lessonIds.size > 0">
                and lesson_id in
                <foreach collection="lessonIds" open="(" close=")" item="lessonId" separator=",">
                    #{lessonId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByTime" resultMap="baseResultMap">
        select * from oj_lesson_record
        <where>
            <if test="null != userId and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="null != start">
                and update_time &gt; #{start}
            </if>
            <if test="null != end">
                and update_time &lt; #{end}
            </if>
        </where>
        order by create_time asc
    </select>

    <select id="selectByLessonAndUser" resultMap="baseResultMap">
        select * from oj_lesson_record
        <where>
            `user_id` = #{userId}
            and lesson_id = #{lessonId}
        </where>
    </select>

    <update id="updateLearnedTime">
        update oj_lesson_record
        <set>
            room_id = #{roomId},
            learned_type = #{learnedType},
            update_time = now()
        </set>
        where
        lesson_id = #{lessonId}
        and course_id = #{courseId}
        and user_id = #{userId}
    </update>


    <select id="selectRecentCoursesByUser" resultType="com.cyberpeace.oj.course.dao.entity.LessonRecord">
        select course_id,
               max(update_time) as update_time
        from oj_lesson_record
        where user_id  = #{userId}
        group by course_id order by update_time desc
        limit #{count}

    </select>


</mapper>
