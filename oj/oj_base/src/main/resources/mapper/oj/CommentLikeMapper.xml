<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.ojbase.dao.mapper.CommentLikeMapper">

    <resultMap id="base" type="com.cyberpeace.oj.ojbase.dao.entity.CommentLike"/>

    <sql id="orderByTimeDesc">
        order by create_time desc
    </sql>

    <select id="listByComment" resultMap="base">
        select * from oj_comment_like
        where comment_id = #{commentId}
        <include refid="orderByTimeDesc"/>
    </select>

    <select id="selectByCommentAndUser" resultMap="base">
        select * from oj_comment_like
        <where>
            `user_id` = #{userId}
            and comment_id = #{commentId}
        </where>
    </select>

    <delete id="deleteByUserAndId">
        delete from oj_comment_like
        where user_id = #{userId}
        and comment_id = #{commentId}
    </delete>

    <delete id="deleteByCommentIds">
        delete from oj_comment_like
        <where>
            <if test="commentIds != null and commentIds.size() != 0">
                comment_id in
                <foreach collection="commentIds" item="commentId" separator="," close=")" open="(">
                    #{commentId}
                </foreach>
            </if>
        </where>
    </delete>

</mapper>
