<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.ojbase.dao.mapper.CommentMapper">
    <resultMap id="base" type="com.cyberpeace.oj.ojbase.dao.entity.Comment"/>

    <update id="addReadCount">
        UPDATE `oj_comment`
        SET `read_count` = `read_count` + 1
        WHERE `resource_id` IN
        <foreach collection="commentIds" item="commentId" separator="," open="(" close=")">
            #{commentId}
        </foreach>
    </update>


    <select id="firstByResource" resultMap="base">
        select * from oj_comment
        <where>
            <if test="businessId != null and businessId != ''">
                business_id = #{businessId}
            </if>
            <if test="businessType != null">
                and business_type = #{businessType}
            </if>
            and root_id is null
        </where>
    </select>

    <select id="selectByParent" resultMap="base">
        select * from oj_comment
        where root_id = #{parent}
        order by create_time asc
    </select>

    <update id="updateComment">
        update oj_comment
        <set>
            <if test="themeName != null and themeName != ''">
                theme_name = #{themeName},
            </if>
            <if test="content != null and content != ''">
                content = #{content},
            </if>
        </set>
        <where>
            <if test="businessId != null and businessId != ''">
                business_id = #{businessId}
            </if>
            <if test="businessType != null">
                and business_type = #{businessType}
            </if>
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
        </where>
    </update>

    <delete id="deleteByBusinessId">
        delete from oj_comment
        where business_id = #{businessId}
    </delete>

    <select id="selectByReply" resultMap="base">
        select * from oj_comment
        where reply_id = #{replyId}
    </select>

    <select id="selectIdsByParent" resultType="java.lang.String">
        select resource_id from oj_comment
        <where>
            <if test="parents != null and parents.size() != 0">
                root_id in
                <foreach collection="parents" item="parent" separator="," close=")" open="(">
                    #{parent}
                </foreach>
            </if>
            <if test="parents != null and parents.size() != 0">
                or reply_id in
                <foreach collection="parents" item="parent" separator="," close=")" open="(">
                    #{parent}
                </foreach>
            </if>
        </where>
    </select>
    <select id="selectAllByParent" resultMap="base">
        select * from oj_comment
        where root_id = #{parentId}
    </select>

    <select id="selectParent" resultMap="base">
        select * from oj_comment
        <where>
            <if test="businessType != null and businessType != ''">
                business_type = #{businessType}
            </if>
            <if test="content != null and content != ''">
                <bind name="contentLike" value="'%' + content + '%'"/>
                and (content like #{contentLike} or theme_name like #{contentLike})
            </if>
            and root_id is null
        </where>
    </select>
</mapper>
