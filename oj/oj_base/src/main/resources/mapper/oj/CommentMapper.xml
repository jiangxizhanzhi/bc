<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.ojbase.dao.mapper.CommentMapper">
    <resultMap id="base" type="com.cyberpeace.oj.ojbase.dao.entity.Comment"/>

    <sql id="orderByTimeDesc">
        order by create_time desc
    </sql>

    <select id="firstByResource" resultMap="base">
        select * from oj_comment
        <where>
            <if test="businessId != null and businessId != ''">
                business_id = #{businessId}
            </if>
            <if test="businessType != null">
                and business_type = #{businessType}
            </if>
            and root_id is null
        </where>
        <include refid="orderByTimeDesc"/>
    </select>

    <select id="selectByParent" resultMap="base">
        select * from oj_comment
        where root_id = #{parent}
        <include refid="orderByTimeDesc"/>
    </select>

    <update id="updateComment">
        update oj_comment
        <set>
            <if test="themeName != null and themeName != ''">
                theme_name = #{themeName},
            </if>
            <if test="content != null and content != ''">
                content = #{content},
            </if>
        </set>
        <where>
            <if test="businessId != null and businessId != ''">
                business_id = #{businessId}
            </if>
            <if test="businessType != null">
                and business_type = #{businessType}
            </if>
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
        </where>
    </update>

    <delete id="deleteByBusinessId">
        delete from oj_comment
        where business_id = #{businessId}
    </delete>
</mapper>
