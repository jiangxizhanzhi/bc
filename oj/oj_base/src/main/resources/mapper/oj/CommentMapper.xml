<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.ojbase.dao.mapper.CommentMapper">
    <resultMap id="base" type="com.cyberpeace.oj.ojbase.dao.entity.Comment"/>
    <sql id="baseFiled">
        select resource_id, reply, resource, theme_name, `user`,
               comment, comment_type, create_time, parent_id
        from x_comment_comment
    </sql>

    <sql id="orderByTimeDesc">
        order by create_time desc
    </sql>

    <select id="firstByResource" resultMap="base">
        <include refid="baseFiled"/>
        where resource = #{resource} and parent_id is null
        and status = 1
        <include refid="orderByTimeDesc"/>
    </select>

    <select id="selectByParent" resultMap="base">
        <include refid="baseFiled"/>
        where parent_id = #{parent}
        and status = 1
        <include refid="orderByTimeDesc"/>
    </select>

</mapper>
