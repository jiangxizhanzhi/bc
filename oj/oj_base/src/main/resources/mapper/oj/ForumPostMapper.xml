<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.oj.ojbase.dao.mapper.ForumPostMapper">
    <delete id="deleteByIdsAndUserId">
        delete from oj_forum_post
        where type = #{type} and user_id = #{userId}
        and resource_id in
        <foreach collection="ids" separator="," open="(" close=")" item="id">
            #{id}
        </foreach>
    </delete>
    <select id="page" resultType="com.cyberpeace.oj.ojbase.service.bo.post.ForumPostBo">
        select *
        from oj_forum_post
        where type = #{type}
    </select>
</mapper>