<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.ojbase.dao.mapper.NoteEvaluateMapper">

    <resultMap id="base" type="com.cyberpeace.oj.ojbase.dao.entity.NoteEvaluate"/>

    <select id="selectByNote" resultMap="base">
        select * from oj_note_evaluate
        where note_id = #{noteId}
    </select>

    <update id="updateByNote">
        update oj_note_evaluate
        <set>
            <if test="score != null">
                score = #{score}
            </if>
            <if test="evaluateComment != null and evaluateComment != ''">
                , evaluate_comment = #{evaluateComment}
            </if>
            <if test="evaluatorId != null and evaluatorId != ''">
                , evaluator_id = #{evaluatorId}
            </if>
            <if test="passed != null">
                , passed = #{passed}
            </if>
            <if test="evaluateTime != null">
                , evaluate_time = #{evaluateTime}
            </if>
        </set>
        where note_id = #{noteId}
    </update>

    <select id="selectBatchNoteIds" resultMap="base">
        select * from oj_note_evaluate
        where note_id in
        <foreach collection="noteIds" item="noteId" open="(" close=")" separator=",">
            #{noteId}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = 1
        </if>
    </select>
</mapper>
