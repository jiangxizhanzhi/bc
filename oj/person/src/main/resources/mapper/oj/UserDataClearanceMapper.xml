<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.oj.person.dao.mapper.UserDataClearanceMapper">
    <delete id="clearCourseStudyHis">
        delete
        from oj_course_study_history
        where user_id = #{userId}
    </delete>
    <delete id="clearLessonRecord">
        delete
        from oj_lesson_record
        where user_id = #{userId}
    </delete>
    <delete id="clearOjNote">
        delete
        from oj_note
        where user_id = #{userId}
    </delete>
    <delete id="clearPracticeCount">
        delete
        from oj_practice_count
        where user_id = #{userId}
    </delete>
    <delete id="clearPracticeMistake">
        delete
        from oj_practice_mistake
        where user_id = #{userId}
    </delete>
    <delete id="clearPracticeSolved">
        delete
        from oj_practice_solved
        where submit_user_id = #{userId}
    </delete>
    <delete id="clearResourceCollection">
        delete
        from oj_resource_collection
        where user_id = #{userId}
    </delete>
</mapper>