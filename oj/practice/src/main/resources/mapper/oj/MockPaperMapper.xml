<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.MockPaperMapper">
    <select id="selectByCreator" resultType="com.cyberpeace.oj.practice.dao.entity.MockPaper">
        select *
        from oj_mock_paper
        where user_id = #{userId}
          and `actual` = #{actual}
        order by id desc
    </select>
    <select id="selectByPresetIdAndUserId" resultType="com.cyberpeace.oj.practice.dao.entity.MockPaper">
        select *
        from oj_mock_paper
        where preset_id = #{presetId}
          and `user_id` = #{userId}
    </select>
</mapper>