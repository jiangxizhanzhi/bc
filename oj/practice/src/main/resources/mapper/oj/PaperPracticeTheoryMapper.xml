<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PaperPracticeTheoryMapper">

    <select id="selectSolvedByPaperId"
            resultType="com.cyberpeace.oj.practice.controller.res.PracticeSolvedRes">
        select resource_id as practice_id, solved
        from oj_paper_practice_theory
        where paper_id = #{paperId}
    </select>
</mapper>
