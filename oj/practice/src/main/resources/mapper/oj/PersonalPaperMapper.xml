<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PersonalPaperMapper">


    <select id="getLastPaperByUserId" resultType="com.cyberpeace.oj.practice.dao.entity.PersonalPaper">
        select *
        from oj_personal_paper
        <where>
            <if test="userId != null and userId != ''">
                user_id = #{userId}
            </if>
        </where>
        order by create_time desc
        limit 1
    </select>
</mapper>
