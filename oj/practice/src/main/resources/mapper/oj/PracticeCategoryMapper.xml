<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeCategoryMapper">

    <resultMap id="category" type="com.cyberpeace.oj.practice.dao.entity.PracticeCategory"/>

    <select id="pageByTypeAndName" resultMap="category">
        select * from oj_practice_category
        <where>
            resource_id = code
            <if test="practiceType != null">
                and practice_type = #{practiceType}
            </if>
            <if test="pattern != null and pattern != ''">
                <bind name="pattern" value="'%' + pattern + '%'"/>
                and `name` like #{pattern}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="listByTypeAndName" resultMap="category">
        select * from oj_practice_category
        <where>
            resource_id = code
            <if test="practiceType != null">
                and practice_type = #{practiceType}
            </if>
            <if test="pattern != null and pattern != ''">
                <bind name="pattern" value="'%' + pattern + '%'"/>
                and `name` like #{pattern}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectByCode" resultMap="category">
        <bind name="code" value="code + ',' + '%'"/>
        select * from oj_practice_category
        where `code` like #{code}
    </select>

    <select id="selectByName" resultType="java.lang.String">
        select resource_id from oj_practice_category
        where practice_type = #{practiceType}
        and `name` = #{name}
    </select>
</mapper>
