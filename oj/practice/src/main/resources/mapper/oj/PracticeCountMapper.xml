<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeCountMapper">

    <select id="selectByUserId" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeCount">
        select * from oj_practice_count
        where user_id = #{userId}
    </select>

    <select id="getAllPracticeCount" resultType="java.lang.Integer">
        select count(count)
        from oj_practice_count
    </select>

    <select id="getAllPeopleCount" resultType="java.lang.Integer">
        select count(1)
        from oj_practice_count
    </select>
</mapper>
