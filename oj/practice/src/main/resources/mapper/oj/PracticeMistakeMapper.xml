<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeMistakeMapper">

    <delete id="deleteByPracticeIds">
        delete from oj_practice_mistake
        <where>
            <if test="practiceIds != null and practiceIds.size() != 0">
                practice_id in
                <foreach collection="practiceIds" item="practiceId" separator="," open="(" close=")">
                    #{practiceId}
                </foreach>
            </if>
        </where>
    </delete>

    <select id="countByUserId" resultType="java.lang.Integer">
        select count(*)
        from oj_practice_mistake
        <where>
            1=1
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="practiceType != null and practiceType != ''">
                and practice_type = #{practiceType}
            </if>
        </where>
    </select>

    <select id="selectByPracticeId" resultType="com.cyberpeace.oj.practice.controller.res.PersonalMistakeRes">
        select practice_id, content, theory_type, correct, incorrect, category.name as direction, difficulty
        from oj_practice_mistake as mistake
        inner join oj_practice_theory as practice
        on mistake.practice_id = practice.resource_id
        inner join oj_practice_category as category
        on practice.category_id = category.resource_id
        <where>
            <if test="practiceIds != null and practiceIds.size() != 0">
                practice_id in
                <foreach collection="practiceIds" item="practiceId" open="(" close=")" separator=",">
                    #{practiceId}
                </foreach>
            </if>
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
        </where>
    </select>
</mapper>
