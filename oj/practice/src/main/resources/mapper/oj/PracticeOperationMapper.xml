<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeOperationMapper">
    <resultMap id="operation" type="com.cyberpeace.oj.practice.dao.entity.PracticeOperation">
        <result property="isPublic" column="public"/>
    </resultMap>

    <select id="pageByQuery" resultMap="operation">
        select * from oj_practice_operation
        <where>
            <if test="listQuery != null">
                <if test="listQuery.resourceIds != null and listQuery.resourceIds.size() != 0">
                    resource_id in
                    <foreach collection="listQuery.resourceIds" separator="," item="resourceId" open="(" close=")">
                        #{resourceId}
                    </foreach>
                </if>
                <if test="listQuery.practiceSetIds != null and listQuery.practiceSetIds.size() != 0">
                    and practice_set_id in
                    <foreach collection="listQuery.practiceSetIds" open="(" close=")" separator="," item="setId">
                        #{setId}
                    </foreach>
                </if>
                <if test="listQuery.difficulty != null">
                    and difficulty = #{listQuery.difficulty}
                </if>
                <if test="listQuery.categoryIds != null and listQuery.categoryIds.size() != 0">
                    and category_id in
                    <foreach collection="listQuery.categoryIds" open="(" close=")" item="categoryId" separator=",">
                        #{categoryId}
                    </foreach>
                </if>
                <if test="listQuery.pattern != null and listQuery.pattern != ''">
                    <bind name="title" value="'%' + listQuery.pattern + '%'"/>
                    and title like #{title}
                </if>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
        order by `update_time` desc,`id`
    </select>

    <select id="selectBySetIds" resultType="java.lang.String">
        select resource_id from oj_practice_operation
        where practice_set_id in
        <foreach collection="setIds" item="setId" open="(" close=")" separator=",">
            #{setId}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
        order by update_time desc
    </select>

    <select id="selectByCategoryIds" resultType="java.lang.String">
        select resource_id from oj_practice_operation
        where category_id in
        <foreach collection="categoryIds" separator="," open="(" close=")" item="categoryId">
            #{categoryId}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
    </select>

    <select id="randomChoice" resultMap="operation">
        select * from oj_practice_operation
        <where>
            <if test="query.resourceIds != null and query.resourceIds.size() != 0">
                resource_id in
                <foreach collection="query.resourceIds" item="resourceId" open="(" close=")" separator=",">
                    #{resourceId}
                </foreach>
            </if>
            <if test="query.practiceSetIds != null and query.practiceSetIds.size() != 0">
                and practice_set_id in
                <foreach collection="query.practiceSetIds" open="(" close=")" separator="," item="setId">
                    #{setId}
                </foreach>
            </if>
            <if test="query.difficulty != null">
                and difficulty = #{query.difficulty}
            </if>
            <if test="query.categoryIds != null and query.categoryIds.size() != 0">
                and category_id in
                <foreach collection="query.categoryIds" separator="," open="(" close=")" item="categoryId">
                    #{categoryId}
                </foreach>
            </if>
            <if test="query.pattern != null and query.pattern != ''">
                <bind name="pattern" value="'%' + query.pattern + '%'"/>
                and content like #{pattern}
            </if>
        </where>
        order by rand() limit #{limit}
    </select>

    <select id="selectByTitle" resultType="java.lang.String">
        select resource_id from oj_practice_operation
        where practice_set_id = #{practiceSetId}
        and title = #{title}
    </select>

    <select id="topoIdsByIds" resultType="java.lang.String">
        select topo_id from oj_practice_operation
        where resource_id in
        <foreach collection="resource_ids" item="resource_id" separator="," open="(" close=")">
            #{resource_id}
        </foreach>
    </select>

    <select id="listByQuery" resultMap="operation">
        select * from oj_practice_operation
        <where>
            <if test="listQuery != null">
                <if test="listQuery.resourceIds != null and listQuery.resourceIds.size() != 0">
                    resource_id in
                    <foreach collection="listQuery.resourceIds" separator="," item="resourceId" open="(" close=")">
                        #{resourceId}
                    </foreach>
                </if>
                <if test="listQuery.practiceSetIds != null and listQuery.practiceSetIds.size() != 0">
                    and practice_set_id in
                    <foreach collection="listQuery.practiceSetIds" open="(" close=")" separator="," item="setId">
                        #{setId}
                    </foreach>
                </if>
                <if test="listQuery.difficulty != null">
                    and difficulty = #{listQuery.difficulty}
                </if>
                <if test="listQuery.categoryIds != null and listQuery.categoryIds.size() != 0">
                    and category_id in
                    <foreach collection="listQuery.categoryIds" open="(" close=")" item="categoryId" separator=",">
                        #{categoryId}
                    </foreach>
                </if>
                <if test="listQuery.pattern != null and listQuery.pattern != ''">
                    <bind name="title" value="'%' + listQuery.pattern + '%'"/>
                    and title like #{title}
                </if>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="searchBuiltinBySetIds" resultType="java.lang.String">
        select title
        from oj_practice_operation
        where practice_set_id in
        <foreach collection="setIds" separator="," open="(" close=")" item="setId">
            #{setId}
        </foreach>
        and builtin = 1 limit 1
    </select>

    <select id="selectAllCategoryIds" resultMap="operation">
        SELECT distinct category_id, practice_set_id
        FROM oj_practice_operation
    </select>
</mapper>
