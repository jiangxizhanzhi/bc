<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeOperationMapper">
    <resultMap id="operation" type="com.cyberpeace.oj.practice.dao.entity.PracticeOperation"/>

    <update id="batchDelete">
        update practice_operation
        set status = 0
                where status = 1
                  and resource_id in
        <foreach collection="resource_ids" item="resource_id" open="(" close=")" separator=",">
            #{resource_id}
        </foreach>
    </update>

    <select id="batchGet" resultMap="operation">
        select * from practice_operation
        where status = 1
        and resource_id in
        <foreach collection="resource_ids" item="resource_id" separator="," open="(" close=")">
            #{resource_id}
        </foreach>
    </select>

    <select id="pageByQuery" resultMap="operation">
        select * from oj_practice_operation
        <where>
            <if test="query != null">
                <if test="query.resourceIds != null and query.resourceIds.size() != 0">
                    resource_id in
                    <foreach collection="query.resourceIds" separator="," item="resourceId" open="(" close=")">
                        #{resourceId}
                    </foreach>
                </if>
                <if test="query.practiceSetId != null and query.practiceSetId != ''">
                    and practice_set_id = #{query.practiceSetId}
                </if>
                <if test="query.difficulty != null">
                    and difficulty = #{query.difficulty}
                </if>
                <if test="query.categoryIds != null and query.categoryIds.size() != 0">
                    category_id in

                    <foreach collection="query.categoryIds" open="(" close=")" item="categoryId" separator=",">
                        #{categoryId}
                    </foreach>
                </if>
                <if test="query.pattern != null and query.pattern != ''">
                    <bind name="query.pattern" value="'%' + query.pattern + '%'"/>
                    and title like #{query.pattern}
                </if>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectBySetIds" resultType="java.lang.String">
        select resource_id from oj_practice_operation
        where practice_set_id in
        <foreach collection="setIds" item="setId" open="(" close=")" separator=",">
            #{setId}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
    </select>

    <select id="selectByCategoryIds" resultType="java.lang.String">
        select resource_id from oj_practice_operation
        where category_id in
        <foreach collection="categoryIds" separator="," open="(" close=")" item="categoryId">
            #{categoryId}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
    </select>
</mapper>
