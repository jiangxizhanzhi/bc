<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeOperationMapper">
    <select id="getList" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeOperation">
        select * from practice_operation
        where status = 1
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
            and title like #{pattern}
        </if>
        <if test="category != null and category != ''">
            and category = #{category}
        </if>
        <if test="practice_set != null and practice_set != ''">
            and practice_set = #{practice_set}
        </if>
        order by id desc
    </select>

    <update id="batchDelete">
        update practice_operation set status = 0
        where status = 1
        and resource_id in
        <foreach collection="resource_ids" item="resource_id" open="(" close=")" separator=",">
            #{resource_id}
        </foreach>
    </update>

    <select id="batchGet" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeOperation">
        select * from practice_operation
        where status = 1 and resource_id in
        <foreach collection="resource_ids" item="resource_id" separator="," open="(" close=")">
            #{resource_id}
        </foreach>
    </select>


</mapper>
