<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeOperationTargetMapper">
    <delete id="deleteByOperationId">
        delete
        from oj_practice_operation_target
        where operation_id = #{operationId}
    </delete>

    <select id="getAllByOperationIds" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeOperationTarget">
        select *
        from oj_practice_operation_target
        <where>
            <if test="operationIds != null and operationIds.size() != 0">
                operation_id in
                <foreach collection="operationIds" item="operationId" close=")" open="(" separator=",">
                    #{operationId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="getAllByTargetIds" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeOperationTarget">
        select *
        from oj_practice_operation_target
        <where>
            <if test="targetIds != null and targetIds.size() != 0">
                node_id in
                <foreach collection="targetIds" item="targetId" close=")" open="(" separator=",">
                    #{targetId}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
