<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeRandomFlagMapper">

    <resultMap id="base" type="com.cyberpeace.oj.practice.dao.entity.PracticeRandomFlag"/>

    <select id="fileIdByUserAndPractice" resultType="java.lang.String">
        select attachment_id from oj_practice_random_flag
        where user_id = #{userId}
        and practice_id = #{practiceId}
    </select>
</mapper>
