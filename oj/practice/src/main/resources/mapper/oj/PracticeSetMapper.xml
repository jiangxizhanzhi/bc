<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeSetMapper">
    <resultMap id="set" type="com.cyberpeace.oj.practice.dao.entity.PracticeSet">
        <result property="isPublic" column="public"/>
    </resultMap>

    <select id="selectByAuthContext" resultType="java.lang.String">
        select resource_id from oj_practice_set
    </select>

    <select id="pageByTypeAndName" resultMap="set">
        select * from oj_practice_set
        <where>
            <if test="listQuery != null">
                <if test="listQuery.setIds != null and listQuery.setIds.size() > 0">
                    resource_id in
                    <foreach collection="listQuery.setIds" separator="," item="setId" open="(" close=")">
                        #{setId}
                    </foreach>
                </if>
                <if test="listQuery.practiceType != null">
                    and practice_type = #{listQuery.practiceType}
                </if>
                <if test="listQuery.pattern != null and listQuery.pattern != ''">
                    <bind name="pattern" value="'%' + listQuery.pattern + '%'"/>
                    and `name` like #{pattern}
                </if>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByType" resultMap="set">
        select * from oj_practice_set
        <where>
            <if test="practiceType != null">
                practice_type = #{practiceType}
            </if>
        </where>
    </select>

    <select id="selectByName" resultType="java.lang.String">
        select resource_id
        from oj_practice_set
        WHERE `name` = #{name}
    </select>


    <select id="selectByNames" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeSet">
        select resource_id, name from oj_practice_set
        where `name` in
        <foreach collection="names" item="name" open="(" close=")" separator=",">
            #{name}
        </foreach>
    </select>

    <select id="pageByNameAndType" resultMap="set">
        select * from
        (
        SELECT ops.`id`, ops.`resource_id`, ops.`builtin`, ops.`practice_type`, ops.`name`, ops.`logo`, ops.`public`,
        ops.`create_user_id`, ops.`operation_auth_type`, ops.`operation_auth_ids`, ops.`read_auth_type`,
        ops.`read_auth_ids`, ops.`create_time`, ops.`update_time`, opt.practice_count as practice_count
        FROM oj_practice_set as ops LEFT JOIN
        (SELECT practice_set_id, count(id) practice_count FROM oj_practice_theory GROUP BY practice_set_id) AS opt
        ON ops.resource_id = opt.practice_set_id where ops.practice_type = 0
        UNION ALL
        SELECT ops.`id`, ops.`resource_id`, ops.`builtin`, ops.`practice_type`, ops.`name`, ops.`logo`, ops.`public`,
        ops.`create_user_id`, ops.`operation_auth_type`, ops.`operation_auth_ids`, ops.`read_auth_type`,
        ops.`read_auth_ids`, ops.`create_time`, ops.`update_time`, opo.practice_count
        FROM oj_practice_set as ops LEFT JOIN
        (SELECT practice_set_id, count(id) practice_count FROM oj_practice_operation GROUP BY practice_set_id) AS opo
        ON ops.resource_id = opo.practice_set_id where ops.practice_type = 2
        ) as practice_set
        <where>
            <if test="listQuery != null">
                <if test="listQuery.setIds != null and listQuery.setIds.size() > 0">
                    resource_id in
                    <foreach collection="listQuery.setIds" separator="," item="setId" open="(" close=")">
                        #{setId}
                    </foreach>
                </if>
                <if test="listQuery.practiceType != null">
                    and practice_type = #{listQuery.practiceType}
                </if>
                <if test="listQuery.pattern != null and listQuery.pattern != ''">
                    <bind name="pattern" value="'%' + listQuery.pattern + '%'"/>
                    and `name` like #{pattern}
                </if>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>
    <select id="selectByAuthAndPublic" resultType="java.lang.String">
        select resource_id from oj_practice_set
        <where>
            <if test="!authContext.isSuperAdmin">
                <choose>
                    <when test="authContext.isWeb">
                        <choose>
                            <when test="authContext.organization != null and authContext.organization != ''">
                                <bind name="likeOrganization" value="'%' + authContext.organization + '%'"/>
                                (create_user_id = #{authContext.userId} or (read_auth_ids like #{likeOrganization}
                                and read_auth_type = 2) or read_auth_type = 1)
                            </when>
                            <otherwise>
                                1 != 1
                            </otherwise>
                        </choose>
                    </when>
                    <otherwise>
                        <bind name="likeUser" value="'%' + authContext.userId + '%'"/>
                        (create_user_id = #{authContext.userId}
                        or (operation_auth_ids like #{likeUser}
                        and operation_auth_type = 2)
                        or operation_auth_type = 1)
                    </otherwise>
                </choose>
            </if>
            <if test="null != isPublic and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectPracticeSetByUserId" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeSet">
        select * from oj_practice_set
        <where>
            <bind name="likeUser" value="'%' + userId + '%'"/>
            operation_auth_ids like #{likeUser}
        </where>
    </select>

    <select id="selectPracticeSetByOrgId" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeSet">
        select * from oj_practice_set
        <where>
            <bind name="likeOrganization" value="'%' + orgId + '%'"/>
            read_auth_ids like #{likeOrganization}
        </where>
    </select>

    <select id="selectByIdsAndType" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeSet">
        select * from oj_practice_set
        <where>
            <if test="setIds != null and setIds.size() >0">
                resource_id in
                <foreach collection="setIds" item="setId" separator="," close=")" open="(">
                    #{setId}
                </foreach>
            </if>
            <if test="setType != null">
                and practice_type = #{setType}
            </if>
            and `public` = true
        </where>
    </select>

    <select id="selectInResourceIds" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeSet">
        SELECT *
        FROM oj_practice_set
        <where>
            <if test="resourceIds != null and resourceIds.size() > 0">
                AND resource_id IN
                <foreach collection="resourceIds" item="resourceId" separator="," open="(" close=")">
                    #{resourceId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="getAllSource" resultType="java.lang.String">
        select source from oj_practice_set GROUP BY source
    </select>
</mapper>
