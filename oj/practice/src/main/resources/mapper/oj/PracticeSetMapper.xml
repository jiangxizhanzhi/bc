<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeSetMapper">
    <resultMap id="set" type="com.cyberpeace.oj.practice.dao.entity.PracticeSet">
        <result property="isPublic" column="public"/>
    </resultMap>

    <select id="getAll" resultType="com.cyberpeace.oj.practice.service.externalBo.PracticeSetSimple">
        select *
        from practice_set
        where status = 1
          and practice_type = 0
        order by id desc
    </select>

    <select id="selectByAuthContext" resultType="java.lang.String">
        select resource_id
        from oj_practice_set
        <where>
            <if test="authContext != null">
                <if test="!authContext.isSuperAdmin">
                    <choose>
                        <when test="authContext.isWeb">
                            (create_user_id = #{authContext.userId} or
                             (read_auth_ids like #{authContext.likeOrganization}
                                     and read_auth_type = 2) or read_auth_type = 1)
                        </when>
                        <otherwise>
                            (create_user_id = #{authContext.userId}
                                    or (operation_auth_ids like #{authContext.likeUser}
                                   and operation_auth_type = 2)
                                    or operation_auth_type = 1)
                        </otherwise>
                    </choose>
                </if>
            </if>
        </where>
    </select>

    <select id="pageByTypeAndName" resultMap="set">
        select *
        from oj_practice_set
        <where>
            <if test="listQuery != null">
                <if test="listQuery.setIds != null and listQuery.setIds.size() > 0">
                    resource_id in
                    <foreach collection="listQuery.setIds" separator="," item="setId" open="(" close=")">
                        #{setId}
                    </foreach>
                </if>
                <if test="listQuery.practiceType != null">
                    and practice_type = #{listQuery.practiceType}
                </if>
                <if test="listQuery.pattern != null and listQuery.pattern != ''">
                    <bind name="listQuery.pattern" value="'%' + listQuery.pattern + '%'"/>
                    and `name` like #{listQuery.pattern}
                </if>
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectByType" resultMap="set">
        select *
        from oj_practice_set
        <where>
            <if test="practiceType != null">
                practice_type = #{practiceType}
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>
</mapper>
