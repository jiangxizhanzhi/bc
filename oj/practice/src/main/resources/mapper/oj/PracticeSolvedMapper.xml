<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeSolvedMapper">
    <resultMap id="solved" type="com.cyberpeace.oj.practice.dao.entity.PracticeSolved"/>

    <select id="selectUserAndId" resultMap="solved">
        select *
        from oj_practice_solved
        where submit_user_id = #{userId}
          and practice_id = #{practiceId}
    </select>

    <select id="selectUserAndSolved" resultType="java.lang.String">
        select practice_id from oj_practice_solved
        <where>
            <if test="userId != null and userId != ''">
                submit_user_id = #{userId}
            </if>
            <if test="practiceType != null">
                and practice_type = #{practiceType}
            </if>
            <if test="solved != null">
                and solved = #{solved}
            </if>
        </where>
    </select>
</mapper>
