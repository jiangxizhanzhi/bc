<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeTheoryMapper">

    <resultMap id="theory" type="com.cyberpeace.oj.practice.dao.entity.PracticeTheory">
        <result property="isPublic" column="public"/>
    </resultMap>

    <select id="getList" resultMap="theory">
        select * from oj_practice_theory
        <where>
            <if test="pattern != null and pattern != ''">
                <bind name="pattern" value="'%' + pattern + '%'"/>
                content like #{pattern}
            </if>
            <if test="category != null and category != ''">
                and category_id = #{category}
            </if>
            <if test="practice_set_ids != null and practice_set_ids.size() != 0">
                and practice_set_id in
                <foreach collection="practice_set_ids" close=")" open="(" item="setId" separator=",">
                    #{setId}
                </foreach>
            </if>
            <if test="question_type != null">
                and theory_type = #{question_type}
            </if>
            <if test="difficulty != null">
                and difficulty = #{difficulty}
            </if>
            and `public` = true
        </where>
        order by id desc
    </select>

    <select id="batchGet" resultMap="theory">
        select * from oj_practice_theory
        where resource_id in
        <foreach collection="resource_ids" item="resource_id" separator="," open="(" close=")">
            #{resource_id}
        </foreach>
    </select>

    <select id="randomChoice" resultMap="theory">
        select * from oj_practice_theory
        <where>
            <if test="query.resourceIds != null and query.resourceIds.size() != 0">
                resource_id in
                <foreach collection="query.resourceIds" item="resourceId" open="(" close=")" separator=",">
                    #{resourceId}
                </foreach>
            </if>
            <if test="query.practiceSetIds != null and query.practiceSetIds.size() != 0">
                and practice_set_id in
                <foreach collection="query.practiceSetIds" open="(" close=")" separator="," item="setId">
                    #{setId}
                </foreach>
            </if>
            <if test="query.questionType != null">
                and theory_type = #{query.questionType}
            </if>
            <if test="query.difficulty != null">
                and difficulty = #{query.difficulty}
            </if>
            <if test="query.categoryIds != null and query.categoryIds.size() != 0">
                and category_id in
                <foreach collection="query.categoryIds" separator="," open="(" close=")" item="categoryId">
                    #{categoryId}
                </foreach>
            </if>
            <if test="query.pattern != null and query.pattern != ''">
                <bind name="pattern" value="'%' + query.pattern + '%'"/>
                and content like #{pattern}
            </if>
        </where>
        order by rand() limit #{limit}
    </select>

    <select id="pageByQuery" resultMap="theory">
        select * from oj_practice_theory
        <where>
            <if test="listQuery.resourceIds != null and listQuery.resourceIds.size() != 0">
                resource_id in
                <foreach collection="listQuery.resourceIds" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
            <if test="listQuery.practiceSetIds != null and listQuery.practiceSetIds.size() != 0">
                and practice_set_id in
                <foreach collection="listQuery.practiceSetIds" open="(" close=")" item="setId" separator=",">
                    #{setId}
                </foreach>
            </if>
            <if test="listQuery.categoryIds != null and listQuery.categoryIds.size() != 0">
                and category_id in
                <foreach collection="listQuery.categoryIds" open="(" close=")" separator="," item="categoryId">
                    #{categoryId}
                </foreach>
            </if>
            <if test="listQuery.questionType != null">
                and theory_type = #{listQuery.questionType}
            </if>
            <if test="listQuery.difficulty != null">
                and difficulty = #{listQuery.difficulty}
            </if>
            <if test="listQuery.pattern != null and listQuery.pattern != ''">
                <bind name="pattern" value="'%' + listQuery.pattern + '%'"/>
                and content like #{pattern}
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
    </select>

    <select id="selectBySetIds" resultType="java.lang.String">
        select resource_id from oj_practice_theory
        where practice_set_id in
        <foreach collection="setIds" separator="," open="(" close=")" item="setId">
            #{setId}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
        order by `update_time` desc,`id`;
    </select>

    <select id="selectByCategoryIds" resultType="java.lang.String">
        select resource_id from oj_practice_theory
        where category_id in
        <foreach collection="categoryIds" item="categoryId" open="(" close=")" separator=",">
            #{categoryId}
        </foreach>
        <if test="isPublic != null and isPublic">
            and `public` = #{isPublic}
        </if>
    </select>

    <select id="selectByContent" resultType="java.lang.String">
        select resource_id from oj_practice_theory
        where practice_set_id = #{practiceSetId}
        and content = #{content}
        limit 0,1
    </select>

    <select id="selectSimple" resultType="com.cyberpeace.oj.practice.service.externalbo.TheorySimpleBo">
        select resource_id, theory_type from oj_practice_theory
        <where>
            <if test="query.resourceIds != null and query.resourceIds.size() != 0">
                resource_id in
                <foreach collection="query.resourceIds" item="resourceId" open="(" close=")" separator=",">
                    #{resourceId}
                </foreach>
            </if>
            <if test="query.practiceSetIds != null and query.practiceSetIds.size() != 0">
                and practice_set_id in
                <foreach collection="query.practiceSetIds" open="(" close=")" separator="," item="setId">
                    #{setId}
                </foreach>
            </if>
            <if test="query.questionType != null">
                and theory_type = #{query.questionType}
            </if>
            <if test="query.difficulty != null">
                and difficulty = #{query.difficulty}
            </if>
            <if test="query.categoryIds != null and query.categoryIds.size() != 0">
                and category_id in
                <foreach collection="query.categoryIds" separator="," open="(" close=")" item="categoryId">
                    #{categoryId}
                </foreach>
            </if>
            <if test="query.pattern != null and query.pattern != ''">
                <bind name="pattern" value="'%' + query.pattern + '%'"/>
                and content like #{pattern}
            </if>
            <if test="isPublic != null and isPublic">
                and `public` = #{isPublic}
            </if>
        </where>
        order by id asc
    </select>

    <select id="searchBuiltinBySetIds" resultType="java.lang.String">
        select title
        from oj_practice_theory
        where practice_set_id in
        <foreach collection="setIds" separator="," open="(" close=")" item="setId">
            #{setId}
        </foreach>
        and builtin = 1 limit 1
    </select>

    <select id="selectAllByCreatePaper" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeTheory">
        select *
        from oj_practice_theory
        <where>
            resource_id in
            <foreach collection="practiceIds" separator="," open="(" close=")" item="practiceId">
                #{practiceId}
            </foreach>
            <if test="difficulties != null and difficulties.size() != 0">
                and difficulty in
                <foreach collection="difficulties" separator="," open="(" close=")" item="difficultyItem">
                    #{difficultyItem}
                </foreach>
            </if>
            <if test="types != null and types.size() != 0">
                and theory_type in
                <foreach collection="types" separator="," open="(" close=")" item="typeItem">
                    #{typeItem}
                </foreach>
            </if>
            <if test="directions != null and directions.size() != 0">
                and category_id in
                <foreach collection="directions" separator="," open="(" close=")" item="directionItem">
                    #{directionItem}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByGroup" resultType="com.cyberpeace.oj.practice.controller.res.CategoryProgressRes">
        select category_id categoryId,count(1) sum, SUM(if( b.solved is null ,0,1)) count from oj_practice_theory a
        LEFT JOIN oj_practice_solved b  on a.resource_id=b.resource_id
        AND b.submit_user_id = #{userId}  AND b.practice_type = #{practiceType} and b.solved in (0,1)
        <where>
            <if test="listQuery.resourceIds != null and listQuery.resourceIds.size() != 0">
                a.resource_id in
                <foreach collection="listQuery.resourceIds" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
            <if test="listQuery.questionType != null">
                and a.theory_type = #{listQuery.questionType}
            </if>
            <if test="isPublic != null and isPublic">
                and a.`public` = #{isPublic}
            </if>
        </where>
        GROUP BY a.category_id
    </select>
</mapper>
