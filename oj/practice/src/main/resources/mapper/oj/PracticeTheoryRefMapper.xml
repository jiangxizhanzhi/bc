<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeTheoryRefMapper">
    <resultMap id="base" type="com.cyberpeace.oj.practice.dao.entity.PracticeTheoryRef"/>

    <delete id="deleteByPaper">
        delete from oj_practice_theory_ref
        where paper_id = #{paperId}
    </delete>

    <select id="selectByPracticeIds" resultMap="base">
        select * from oj_practice_theory_ref
        <where>
            <if test="paperId != null and paperId != ''">
                paper_id = #{paperId}
            </if>
            <if test="practiceIds != null and practiceIds.size() != 0">
                and origin_id in
                <foreach collection="practiceIds" item="practiceId" open="(" close=")" separator=",">
                    #{practiceId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByPracticeId" resultMap="base">
        select * from oj_practice_theory_ref
        where paper_id = #{paperId}
        and origin_id = #{practiceId}
    </select>

    <select id="selectByPaper" resultType="java.lang.String">
        select resource_id from oj_practice_theory_ref
        where paper_id = #{paperId}
    </select>
    <select id="selectRefByPaper" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeTheoryRef">
        select * from oj_practice_theory_ref
        where paper_id = #{paperId}
    </select>
</mapper>
