<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.practice.dao.mapper.PracticeWrongMapper">

    <select id="selectByUserId" resultType="com.cyberpeace.oj.practice.dao.entity.PracticeWrong">
        select *
        from oj_practice_wrong
        <where>
            <if test="userId != null and userId != ''">
                submit_user_id = #{userId}
            </if>
        </where>
    </select>
</mapper>
