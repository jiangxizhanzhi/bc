<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.rtks.dao.mapper.AbilityMapper">
    <select id="listAbility" resultType="com.cyberpeace.oj.rtks.dao.entity.Ability">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select t.resource_id,t.content,t.create_Time,t.update_Time
        from ability t
        <where>
            <if test="pattern != null and pattern != ''">
                t.resource_id LIKE #{pattern}
                OR t.content LIKE #{pattern}
            </if>
        </where>
    </select>
</mapper>
