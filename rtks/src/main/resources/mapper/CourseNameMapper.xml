<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.rtks.dao.mapper.CourseNameMapper">

    <resultMap id="BaseResultMap" type="com.cyberpeace.rtks.dao.entity.CourseName">
        <result property="resourceId" column="resource_id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        resource_id
        ,name
    </sql>
    <select id="filterId" resultType="java.lang.String">
        select resource_id
        from rtks_course_name
        where resource_id
        in
        <foreach collection="courseIds" item="courseId" open="(" close=")" separator=",">
            #{courseId}
        </foreach>
    </select>
</mapper>
