<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.rtks.dao.mapper.TaskMapper">
    <select id="listTask" resultType="com.cyberpeace.oj.rtks.dao.entity.Task">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select resource_id,content
        from rtks_task
        <where>
            <if test="pattern != null and pattern != ''">
                resource_id LIKE #{pattern}
                OR content LIKE #{pattern}
            </if>
        </where>
    </select>

</mapper>
