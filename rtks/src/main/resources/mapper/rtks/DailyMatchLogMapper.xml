<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.rtks.dao.mapper.DailyMatchLogMapper">
    <select id="selectByUserId" resultType="com.cyberpeace.rtks.dao.entity.DailyMatchLog">
        select *
        from rtks_daily_match_log
        where user_id = #{userId}
        order by id
    </select>
</mapper>