<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.rtks.dao.mapper.LevelMapper">
    <select id="listFrame" resultType="com.cyberpeace.rtks.dao.entity.Level">
        select * from rtks_level
        <where>
            <if test="keyword != null and keyword != ''">
                <bind name="keyword" value="'%' + keyword + '%'"/>
                name LIKE #{keyword} and
            </if>
            frame is null
        </where>
    </select>

    <select id="getChildLevels" resultType="com.cyberpeace.rtks.dao.entity.Level">
        select * from rtks_level
        <where>
            parent = #{levelId}
        </where>
    </select>

    <select id="getLevelsByFrameId" resultType="com.cyberpeace.rtks.dao.entity.Level">
        select * from rtks_level
        <where>
            frame = #{frameId}
        </where>
    </select>


    <select id="getLevelIdsByFrameIds" resultType="java.lang.String">
        select resource_id from rtks_level
        <where>
            frame in
            <foreach collection="frameIds" index="index" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </where>
    </select>

    <update id="changeLevelId">
        update rtks_level
        <set>
            parent = #{target}
        </set>
        <where>
            parent = #{levelId}
        </where>
    </update>
</mapper>
