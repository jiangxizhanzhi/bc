<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.oj.rtks.dao.mapper.RoleMapper">
    <select id="listRole" resultType="com.cyberpeace.oj.rtks.dao.entity.Role">
        select * from rtks_role
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
            <where>name LIKE #{pattern}</where>
        </if>
    </select>
</mapper>
