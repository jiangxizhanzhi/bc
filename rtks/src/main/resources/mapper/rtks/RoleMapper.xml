<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.rtks.dao.mapper.RoleMapper">

    <insert id="copyFromPreset">
        insert into rtks_${table} (${columns})
        select ${columns}
        from init_rtks_${table};
    </insert>

    <select id="getTableColumns" resultType="java.lang.String">
        <choose>
            <when test="@com.cyberpeace.config.db.MybatisConfig@DB_TYPE == 'dm'">
                select listagg(column_name, ',') as columns
                from ALL_TAB_COLUMNS
            </when>
            <otherwise>
                select GROUP_CONCAT(column_name) as columns
                from information_schema.columns
            </otherwise>
        </choose>
        where table_name = 'rtks_${table}'
        and column_name != 'id'
    </select>

    <delete id="removeAll">
        delete
        from rtks_${table}
    </delete>
    <delete id="clearRole">
        delete
        from rtks_role
    </delete>

    <select id="listRole" resultType="com.cyberpeace.rtks.dao.entity.Role">
        select * from rtks_role
        <where>
            <if test="pattern != null and pattern != ''">
                <bind name="pattern" value="'%' + pattern + '%'"/>
                name LIKE #{pattern}
            </if>
            <if test="pattern != null and pattern != '' and frameId != null and frameId != ''">AND</if>
            <if test="frameId != null and frameId != ''">
                level_id in (SELECT resource_id FROM rtks_level where frame = #{frameId})
            </if>
        </where>
    </select>

    <select id="getRolesUnderLevel" resultType="com.cyberpeace.rtks.dao.entity.Role">
        select * from rtks_role
        <where>level_id = #{levelId}</where>
    </select>

    <select id="selectRoleByFrameId" resultType="com.cyberpeace.rtks.dao.entity.Role">
        select *
        from rtks_role
        where level_id in (
            SELECT resource_id FROM rtks_level where frame = #{frameId,jdbcType=INTEGER}
        )
    </select>

    <select id="selectLevelsByRoleId" resultType="com.cyberpeace.rtks.dao.entity.Level">
        select *
        from rtks_level
        where frame = (
            select frame
            from rtks_level,
                 rtks_role
            where rtks_level.resource_id = rtks_role.level_id
              and rtks_role.resource_id = #{resource_id})
           or resource_id = (
            select frame
            from rtks_level,
                 rtks_role
            where rtks_level.resource_id = rtks_role.level_id
              and rtks_role.resource_id = #{resource_id})
    </select>

    <select id="getRoleIdsByLevelIds" resultType="java.lang.String">
        select resource_id from rtks_role
        <where>
            level_id in
            <foreach collection="levelIds" index="index" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </where>
    </select>
    <select id="selectRoleListByIds" resultType="com.cyberpeace.rtks.dao.entity.Role">


        <foreach collection="ids" item="item" separator="union">
            select *
            from rtks_role
            <where>
                <if test="type == 'knowledge'">
                    knowledge_ids like '%"${item}"%'
                </if>
            </where>
        </foreach>

    </select>
    <select id="ifNameDuplicate" resultType="java.lang.Boolean">
        select case
        when exists(select 1
        from rtks_role where name = #{name}
        <if test="resourceId != null and resourceId != ''">
            and resource_id != #{resourceId}
        </if>
        )then 1
        else 0
        end
        as result
    </select>
</mapper>
