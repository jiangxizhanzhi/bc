<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.rtks.dao.mapper.RoleMapper">
    <select id="listRole" resultType="com.cyberpeace.rtks.dao.entity.Role">
        select * from rtks_role
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
            <where>name LIKE #{pattern}</where>
        </if>
    </select>

    <select id="getRolesUnderLevel" resultType="com.cyberpeace.rtks.dao.entity.Role">
        select * from rtks_role
        <where>level_id = #{levelId}</where>
    </select>

    <select id="selectRoleByFrameId" resultType="com.cyberpeace.rtks.dao.entity.Role">
        select *
        from rtks_role
        where level_id in (
            SELECT resource_id FROM `ojj`.`rtks_level` where frame = #{frameId,jdbcType=INTEGER}
        )
    </select>

    <select id="getRolesIdsUnderLevels" resultType="java.lang.String">
        select resource_id from rtks_role
        <where>
            level_id in
            <foreach collection="levelIds" index="index" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </where>
    </select>
</mapper>
