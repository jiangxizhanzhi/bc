<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.oj.rtks.dao.mapper.SkillCategoryMapper">

    <select id="listSkillCategory" resultType="com.cyberpeace.oj.rtks.dao.entity.SkillCategory">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select resource_id,content
        from rtks_skill_category
        <where>
            <if test="pattern != null and pattern != ''">
                content like #{pattern}
            </if>
        </where>
    </select>

</mapper>
