<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.rtks.dao.mapper.SkillMapper">
    <delete id="clearAll">
        delete
        from rtks_skill
    </delete>

    <resultMap id="SkillResMap" type="com.cyberpeace.rtks.service.bo.skill.SkillRes">
        <result column="resource_id" property="resourceId"/>
        <result column="content" property="content"/>
        <collection property="missions" ofType="com.cyberpeace.rtks.service.bo.skill.MissionRes">
            <result column="title" property="title"/>
            <result column="scene_name" property="sceneName"/>
            <result column="scene_type" property="sceneType"/>
            <result column="scene_difficulty" property="sceneDifficulty"/>
            <result column="weight" property="weight"/>
        </collection>
    </resultMap>


    <select id="listSkill" resultType="com.cyberpeace.rtks.service.bo.skill.SkillRes">
        <if test="skillListReq.pattern != null and skillListReq.pattern != ''">
            <bind name="pattern" value="'%' + skillListReq.pattern + '%'"/>
        </if>
        select
        resource_id, content
        from
        rtks_skill
        <where>
            <if test="skillListReq.pattern != null and skillListReq.pattern != ''">
                rtks_skill.resource_id like #{pattern}
                or rtks_skill.content like #{pattern}
            </if>
        </where>
    </select>

    <select id="existByResourceId" resultType="java.lang.Boolean">
        select case
                   when exists(select 1
                               from rtks_skill
                               where resource_id = #{resourceId})
                       then 1
                   else 0
                   end
                   as result;
    </select>
    <select id="pageSimple" resultType="com.cyberpeace.rtks.service.bo.skill.SkillSimpleRes">
        <if test="reqBase.pattern != null and reqBase.pattern != ''">
            <bind name="pattern" value="'%' + reqBase.pattern + '%'"/>
        </if>
        select
        rtks_skill.resource_id as resource_id,
        rtks_skill.content as content,
        count(rtks_skill_mission_relation.id) as mission_count
        from
        rtks_skill left join rtks_skill_mission_relation
        on rtks_skill.resource_id = rtks_skill_mission_relation.skill_id
        <where>
            <if test="reqBase.pattern != null and reqBase.pattern != ''">
                rtks_skill.resource_id like #{pattern}
                or rtks_skill.content like #{pattern}
            </if>
        </where>
        group by rtks_skill_mission_relation.skill_id
        order by rtks_skill.resource_id
    </select>
    <select id="validateIds" resultType="java.lang.String">
        select resource_id from rtks_skill where resource_id
        in
        <foreach collection="skillIds" item="skillId" open="(" close=")" separator=",">
            #{skillId}
        </foreach>
    </select>
    <select id="pageByRoleId" resultType="com.cyberpeace.rtks.service.bo.skill.SkillResBase">
        select rtks_skill.resource_id,
               rtks_skill.content
        from rtks_role_skill_relation
                 inner join rtks_skill on rtks_role_skill_relation.skill_id = rtks_skill.resource_id
        where rtks_role_skill_relation.role_id = #{roleId}
    </select>


</mapper>
