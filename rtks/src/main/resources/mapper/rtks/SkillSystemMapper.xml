<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.rtks.dao.mapper.SkillSystemMapper">

    <update id="updateDefaultSceneSkillSystem">
        update rtks_skill_system
        set scene_id=0
    </update>

    <update id="updateSceneSkillSystem">
        update rtks_skill_system
        set scene_id=#{sceneId}
        where resource_id = #{skillSystemId}
    </update>

    <select id="listSkillSystem" resultType="com.cyberpeace.rtks.dao.entity.SkillSystem">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select resource_id,content
        from rtks_skill_system
        <where>
            <if test="pattern != null and pattern != ''">
                content like #{pattern}
            </if>
        </where>
    </select>

</mapper>
