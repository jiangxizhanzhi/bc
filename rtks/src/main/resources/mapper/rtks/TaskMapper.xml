<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.cyberpeace.rtks.dao.mapper.TaskMapper">
    <select id="listTask" resultType="com.cyberpeace.rtks.dao.entity.Task">
        <if test="pattern != null and pattern != ''">
            <bind name="pattern" value="'%' + pattern + '%'"/>
        </if>
        select resource_id,content
        from rtks_task
        <where>
            <if test="pattern != null and pattern != ''">
                resource_id like #{pattern}
                or content like #{pattern}
            </if>
        </where>
    </select>

    <select id="filterIds" resultType="java.lang.String">
        select resource_id
        from rtks_task
        <where>
            resource_id in
            <foreach collection="ids" index="index" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </where>
    </select>
</mapper>
