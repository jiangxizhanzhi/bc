<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.scene.dao.mapper.ConnectionMapper">
    <delete id="deleteBySceneId">
        delete
        from cr_connection
        where scene_id = #{sceneId}
    </delete>
    <delete id="clear">
        delete from cr_connection
    </delete>
    <select id="selectByNodeId" resultType="com.cyberpeace.scene.dao.entity.ConnectionEntity">
        select *
        from cr_connection
        where node_id = #{nodeId}
    </select>
    <select id="selectBySceneId" resultType="com.cyberpeace.scene.dao.entity.ConnectionEntity">
        select *
        from cr_connection
        where scene_id = #{sceneId}
    </select>
    <select id="selectAll" resultType="com.cyberpeace.scene.dao.entity.ConnectionEntity">
        select * from cr_connection;
    </select>
</mapper>