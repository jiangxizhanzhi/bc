<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.scene.dao.mapper.ImageMapper">
    <select id="selectByScenario" resultType="com.cyberpeace.scene.dao.entity.ImageEntity">
        select *
        from cr_image
        where scenario = #{scenario}
    </select>
</mapper>