<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.scene.dao.mapper.NetworkMapper">

    <delete id="deleteByResourceId">
        delete from cr_network where resource_id = #{resourceId}
    </delete>

    <select id="selectBySceneId" resultType="java.lang.String">
        select resource_id from cr_network where scene_id = #{sceneId}
    </select>
</mapper>
