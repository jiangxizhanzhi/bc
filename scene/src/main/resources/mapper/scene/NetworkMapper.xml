<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.scene.dao.mapper.NetworkMapper">
    <update id="updateStatus">
        update cr_network set network_status = #{status} where resource_id = #{resourceId}
    </update>

    <delete id="deleteByResourceId">
        delete from cr_network where resource_id = #{resourceId}
    </delete>


    <select id="selectBySid" resultType="com.cyberpeace.scene.dao.entity.NetworkEntity">
        select * from cr_network where sid = #{sceneId} and network_status = #{status}
    </select>
    <select id="selectBySceneId" resultType="com.cyberpeace.scene.dao.entity.NetworkEntity">
        select * from cr_network where sid = #{sceneId}
    </select>
</mapper>
