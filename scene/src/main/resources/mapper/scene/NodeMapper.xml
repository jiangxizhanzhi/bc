<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.scene.dao.mapper.NodeMapper">

    <update id="updateStatus">
        UPDATE cr_node SET status = #{status} WHERE resource_id = #{resourceId}
    </update>

    <update id="updateByInstanceId">
        update cr_node set status = #{status} where instance_id = #{instanceId}
    </update>

    <select id="selectBySid" resultType="com.cyberpeace.scene.dao.entity.NodeEntity">
        SELECT * FROM cr_node WHERE sid = #{sid}
    </select>
    <select id="selectBySceneAndType" resultType="com.cyberpeace.scene.dao.entity.NodeEntity">
        select * from cr_node where sid = #{sceneId} and type = #{code}
    </select>
</mapper>
