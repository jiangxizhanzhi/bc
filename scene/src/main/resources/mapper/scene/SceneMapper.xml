<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.scene.dao.mapper.SceneMapper">
    <update id="updateSceneStatus">
        update cr_scene set scene_status = #{sceneStatus} where resource_id = #{sceneId}
    </update>

    <update id="updateMeta">
        update cr_scene set meta = #{meta} where resource_id = #{sceneId}
    </update>
    <delete id="deleteByResourceId">
        delete
        from cr_scene
        where resource_id = #{sceneId}
    </delete>
    <delete id="clear">
        delete from cr_scene
    </delete>

    <select id="selectSceneCount" resultType="java.lang.Integer">
        select count(1) from cr_scene where 1=1
        <if test="sceneStatus!= null and sceneStatus!= ''">
            and scene_status in
            <foreach item="item" collection="sceneStatus" open="(" close=")" separator=",">
                #{item}
            </foreach>

        </if>
        <if test="userId != null and userId != ''">
            and user_id = #{userId}
        </if>
    </select>

    <select id="selectByResourceId" resultType="com.cyberpeace.scene.dao.entity.SceneEntity">
        select * from cr_scene where resource_id = #{resourceId}
    </select>

    <select id="selectByInstanceId" resultType="com.cyberpeace.scene.dao.entity.SceneEntity">
        select * from cr_scene where instance_id = #{instanceId} and user_id = #{userId}
        <if test="sceneStatus!= null and sceneStatus!= ''">
            and scene_status in
            <foreach item="item" collection="sceneStatus" open="(" close=")" separator=",">
                #{item}
            </foreach>

        </if>
    </select>
    <select id="selectByUserId" resultType="java.lang.String">
        select resource_id
        from cr_scene
        where user_id = #{userId}
          and scene_status != #{code}
    </select>
    <select id="countAll" resultType="java.lang.Integer">
        select count(*)
        from cr_scene;
    </select>
    <select id="countByUserId" resultType="java.lang.Integer">
        select count(*)
        from cr_scene
        where user_id = #{userId}
    </select>
    <select id="selectByRaceId" resultType="java.lang.String">
        <bind name="search" value="'%' + raceId + '%'"/>
        select resource_id from cr_scene where instance_id like #{search}
    </select>
    <select id="selectByScenario" resultType="com.cyberpeace.scene.dao.entity.SceneEntity">
        select *
        from cr_scene
        where scenario = #{scenario}
        order by id desc
        limit 1
    </select>
</mapper>
