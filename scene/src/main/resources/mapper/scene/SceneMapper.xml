<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.scene.dao.mapper.SceneMapper">

    <select id="selectSceneCount" resultType="java.lang.Integer">
        select count(1) from cr_scene where scene_status = #{sceneStatus}
        <if test="userId != null and userId != ''">
            and user_id = #{userId}
        </if>
    </select>
</mapper>
