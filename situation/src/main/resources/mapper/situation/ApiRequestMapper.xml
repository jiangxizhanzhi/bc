<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.ApiRequestMapper">
    <select id="selectPage" resultType="com.cyberpeace.situation.controller.res.ApiRequestRes">
        select * from situation_api_request where 1 = 1
        <if test="apiRequestPageReq.name != null and apiRequestPageReq.name != ''">
           and name like concat('%', #{apiRequestPageReq.name} ,'%')
        </if>
        <if test="apiRequestPageReq.requestUrl != null and apiRequestPageReq.requestUrl != ''">
            and request_url like concat('%', #{apiRequestPageReq.requestUrl} ,'%')
        </if>
        <if test="apiRequestPageReq.requestMethod != null and apiRequestPageReq.requestMethod != ''">
            and request_method = #{apiRequestPageReq.name}
        </if>
        <if test="authContext != null ">
            and create_user_id = #{authContext.userId}
        </if>
        ORDER BY create_time DESC
    </select>
    <select id="selectByAuthContext" resultType="java.lang.String">
        select resource_id  from situation_api_request where 1 = 1
        <if test="authContext != null">
            and create_user_id = #{authContext.userId}
        </if>
    </select>
    <select id="selectById" resultType="com.cyberpeace.situation.dao.entity.ApiRequest">
        select * from situation_api_request where resource_id = #{resourceId}
    </select>
</mapper>