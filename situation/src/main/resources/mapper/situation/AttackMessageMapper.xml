<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.AttackMessageMapper">

    <insert id="add" parameterType="com.cyberpeace.situation.dao.entity.AttackMessage">
        <selectKey keyProperty="resourceId" order="AFTER" resultType="java.lang.String">
            select uuid()
        </selectKey>
        insert into situation_attack_message
        (name,description,source_id,source_name,target_id,target_name,interval_time,look_at_target,line_style,media_animation)
        value
        (#{name},#{description},#{sourceId},#{sourceName},#{targetId},#{targetName},#{intervalTime},#{lookAtTarget},#{lineStyle},#{mediaAnimation})
    </insert>
    <delete id="deleteBySceneId">
        delete
        from situation_attack_message
        where scene_id = #{sceneId}
    </delete>
    <insert id="addPro">
        insert into scene_property_config
            (`scene`, `desc`, `content`)
        values (#{scene}, null,#{content})
    </insert>

    <update id="updatePro">
        update scene_property_config
        set content = #{content}
        where id = #{id}
    </update>

    <select id="readPro" resultType="com.cyberpeace.situation.dao.entity.ScenePro">
        select *
        from scene_property_config
        where scene = #{scene}
    </select>
</mapper>