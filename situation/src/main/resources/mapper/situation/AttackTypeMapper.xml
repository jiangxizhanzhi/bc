<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.AttackTypeMapper">


    <select id="selectAll" resultType="com.cyberpeace.situation.dao.entity.AttackType">
        select *
        from situation_attack_type
        <where>
            <if test="null != pattern and pattern != ''">
                <bind name="desc" value="'%' + pattern + '%'"/>
                and (cnDesc like #{desc} or enDesc like #{desc}
            </if>
        </where>
    </select>
</mapper>