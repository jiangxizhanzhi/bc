<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.CenterMapper">

    <select id="getCenters" resultType="com.cyberpeace.situation.dao.entity.Center">
        select *
        from situation_center
    </select>
    <select id="getById" resultType="com.cyberpeace.situation.dao.entity.Center">
        select *
        from situation_center
        where center_id = #{centerId}
    </select>
</mapper>