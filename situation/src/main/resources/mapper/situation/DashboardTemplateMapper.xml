<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.DashboardTemplateMapper">

    <select id="selectPage" resultType="com.cyberpeace.situation.controller.res.DashboardTemplatePageRes">
        select * from dashboard_template where 1 = 1
        <if test="dashboardTemplatePageReq.name != null and dashboardTemplatePageReq.name != ''">
            and name like concat('%', #{dashboardTemplatePageReq.name} ,'%')
        </if>
        <if test="dashboardTemplatePageReq.type != null and dashboardTemplatePageReq.type != ''">
            and type = #{dashboardTemplatePageReq.type}
        </if>
        <if test="dashboardTemplatePageReq.level != null">
            and level = #{dashboardTemplatePageReq.level}
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>