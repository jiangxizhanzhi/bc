<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.DataSourceTemplateMapper">

    <select id="getDataSourceType" resultType="java.lang.String">
        select type from situation_datasource_template
    </select>
    <select id="selectByType" resultType="com.cyberpeace.situation.dao.entity.DataSourceTemplate">
        select * from situation_datasource_template where type = #{type}
    </select>
</mapper>
