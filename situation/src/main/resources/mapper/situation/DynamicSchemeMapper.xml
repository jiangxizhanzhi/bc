<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.DynamicSchemeMapper">

    <delete id="deleteBySceneId">
        delete
        from situation_dynamic_scheme
        where scene_id = #{sceneId}
    </delete>

    <select id="getAllNamesBySceneId" resultType="com.cyberpeace.situation.controller.res.DynamicSchemeNameRes">
        select resource_id,name from situation_dynamic_scheme
        <where>
            <if test="sceneId != null and sceneId != ''">
                scene_id = #{sceneId}
            </if>
        </where>
        order by update_time desc
    </select>
    <select id="selectByName" resultType="com.cyberpeace.situation.dao.entity.DynamicScheme">
        select * from situation_dynamic_scheme
        <where>
            name = #{name} and scene_id = #{sceneId}
        </where>
    </select>
    <select id="selectByResourceId" resultType="com.cyberpeace.situation.dao.entity.DynamicScheme">
        select * from situation_dynamic_scheme
        <where>
            resource_id = #{resourceId}
        </where>
    </select>

    <select id="queryLeak" resultType="com.cyberpeace.situation.dao.entity.Vuln">
        select * from situation_vuln
    </select>

    <select id="toolVulnById" resultType="com.cyberpeace.situation.dao.entity.ToolVuln">
        <bind name="leak" value="'%' + leak + '%'"/>
        select * from situation_tool_vuln where tool_type = #{type} and resource_id = #{tool} and vuln_ids like #{leak}
    </select>

    <insert id="addDefense">
        insert into situation_defense
            (resource_id, scene_id, node_id, deacription, vuln_id, type, create_time)
        values
            (#{resourceId}, #{sceneId}, #{nodeId}, #{deacription}, #{vulnId}, #{type}, #{createTime})
    </insert>

    <select id="queryDefenseBySceneId" resultType="com.cyberpeace.situation.dao.entity.Defense">
        select * from situation_defense where scene_id = #{sceneId} and type = #{type}
    </select>

    <delete id="deleteDefenseBySceneId">
        delete from situation_defense
        where scene_id = #{sceneId}
    </delete>

    <select id="queryToolByVulnId" resultType="com.cyberpeace.situation.dao.entity.ToolVuln">
        <bind name="vulnId" value="'%' + vulnId + '%'"/>
        select * from situation_tool_vuln where vuln_ids like #{vulnId} and tool_type = #{toolType}
    </select>

    <select id="queryVulnTop" resultType="com.cyberpeace.situation.dao.entity.Vuln">
        select * from situation_vuln where resource_id in
        <foreach collection="vulns" item="vuln" separator="," close=")" open="(">
            #{vuln}
        </foreach>
    </select>

    <select id="queryDefenseByNodeId" resultType="com.cyberpeace.situation.dao.entity.Defense">
        select * from situation_defense where scene_id = #{sceneId} and node_id = #{nodeId} and type = #{type}
    </select>

    <select id="queryLeakByIds" resultType="com.cyberpeace.situation.dao.entity.Vuln">
        select * from situation_vuln where resource_id in
        <foreach collection="vulns" item="vuln" separator="," close=")" open="(">
            #{vuln}
        </foreach>
    </select>
</mapper>