<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.EventTypeMapper">

    <select id="getEventTypeContextList"
            resultType="com.cyberpeace.situation.dao.entity.EventType">
        select * from situation_event_type
        <if test="isRootNode != null and isRootNode == true">
            where parent_node is null
        </if>
        <if test="isRootNode != null and isRootNode == false">
            where parent_node is not null
        </if>
    </select>
    <select id="selectBatchByName" resultType="com.cyberpeace.situation.dao.entity.EventType">
        select `name`, min(`code`) `code` from situation_event_type
        where name in
        <foreach collection="types" open="(" close=")" separator="," item="type">
            #{type}
        </foreach>
        group by `name`
    </select>
</mapper>