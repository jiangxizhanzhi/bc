<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.GisMarkMapper">

    <select id="getGisMarkList" resultType="com.cyberpeace.situation.service.context.GisMarkContext">
        select * from situation_gis_mark
        <where>
            dashboard_id = #{dashboardId}
            <if test="currentTime == null">
                and delete_time is null
            </if>
            <if test="currentTime != null">
                and create_time &lt; #{currentTime}
                and (delete_time &gt; #{currentTime} or delete_time is null)
            </if>
        </where>

    </select>
</mapper>
