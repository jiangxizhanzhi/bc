<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SceneConfigMapper">

    <delete id="deleteBySceneId">
        delete from situation_scene_config
        <where>
            scene_id = #{sceneId}
        </where>
    </delete>


    <select id="selectBySceneId" resultType="com.cyberpeace.situation.dao.entity.SceneConfig">
        select * from situation_scene_config
        <where>
            scene_id = #{sceneId}
        </where>
    </select>
</mapper>