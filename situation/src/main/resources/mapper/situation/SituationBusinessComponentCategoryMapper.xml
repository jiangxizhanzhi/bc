<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationBusinessComponentCategoryMapper">

    <select id="selectAll" resultType="com.cyberpeace.situation.dao.entity.SituationBusinessComponentCategory">
        SELECT *
        FROM situation_business_component_category
        ORDER BY create_time DESC
    </select>

    <select id="selectByName" resultType="java.lang.String">
        SELECT resource_id
        FROM situation_business_component_category
        WHERE `name` = #{name}
    </select>
</mapper>
