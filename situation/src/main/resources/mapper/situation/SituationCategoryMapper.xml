<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationCategoryMapper">
    <select id="selectByTaskType" resultType="com.cyberpeace.situation.dao.entity.SituationCategory">
        select *
        from situation_category
        where task_type = #{taskType}
    </select>
</mapper>