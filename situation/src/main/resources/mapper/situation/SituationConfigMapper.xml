<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationConfigMapper">

    <select id="filterIds" resultType="String">
        select resource_id from situation_config
        where attribute is not null
        <if test="situationConfigFilterReq.scope != null">
            <bind name="scope" value="'%' + situationConfigFilterReq.scope + '%'"/>
            and scope like #{scope}
        </if>
        <if test="situationConfigFilterReq.nodeId != null">
            <bind name="node_id" value="'%' + situationConfigFilterReq.nodeId + '%'"/>
            and node_id like #{node_id}
        </if>
        <if test="situationConfigFilterReq.nodeName != null">
            <bind name="node_name" value="'%' + situationConfigFilterReq.nodeName + '%'"/>
            and node_name like #{node_name}
        </if>
        <if test="situationConfigFilterReq.nodeType != null">
            and node_type = #{situationConfigFilterReq.nodeType}
        </if>

    </select>
</mapper>
