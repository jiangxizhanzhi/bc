<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationDbAccessAuthorityMapper">
    <select id="selectPage" resultType="com.cyberpeace.situation.dao.entity.SituationDbAccessAuthority">
        SELECT *
        FROM situation_db_access_authority
        WHERE 1 = 1
        ORDER BY create_time DESC
    </select>
    <select id="selectAllowedIps" resultType="java.lang.String">
        SELECT sys_ip
        FROM situation_db_access_authority
        WHERE 1 = 1
    </select>
</mapper>