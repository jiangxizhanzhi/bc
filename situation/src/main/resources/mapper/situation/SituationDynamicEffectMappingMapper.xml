<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationDynamicEffectMappingMapper">

    <select id="selectPage" resultType="com.cyberpeace.situation.dao.entity.DynamicEffectsMapping">
        select * from situation_dynamic_effects_mapping where 1 = 1
        <if test="dynamicEffectMappingPageReq.name != null and dynamicEffectMappingPageReq.name != ''">
            and name like concat('%', #{dynamicEffectMappingPageReq.name} ,'%')
        </if>
        <if test="dynamicEffectMappingPageReq.category != null and dynamicEffectMappingPageReq.category != ''">
            and category = #{dynamicEffectMappingPageReq.category}
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>