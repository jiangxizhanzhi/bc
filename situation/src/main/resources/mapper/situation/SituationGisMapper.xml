<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationGisMapper">
    <select id="selectPage" resultType="com.cyberpeace.situation.controller.res.GisPageRes">
        select * from situation_gis where 1 = 1
        <if test="GisPageReq.name != null and GisPageReq.name != ''">
           and name like concat('%', #{GisPageReq.name} ,'%')
        </if>
        <if test="GisPageReq.type != null">
            and type = #{GisPageReq.type}
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>