<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationIconMapper">

    <select id="selectByName" resultType="java.lang.String">
        SELECT resource_id FROM situation_icon WHERE `name` = #{name}
    </select>
    <select id="selectPage" resultType="com.cyberpeace.situation.controller.res.SituationIconRes">
        SELECT * FROM situation_icon WHERE 1 = 1
        <if test="situationIconPageReq.name != null and situationIconPageReq.name != ''">
            name LIKE concat ('%', #{situationIconPageReq.name} ,"%")
        </if>
        <if test="situationIconPageReq.type != null and situationIconPageReq != ''">
            type =  #{situationIconPageReq.type}
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>