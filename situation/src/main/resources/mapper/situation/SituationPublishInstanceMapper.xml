<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationPublishInstanceMapper">
    <select id="getSituationPublishInstancePage"
            resultType="com.cyberpeace.situation.controller.res.SituationPublishInstancePageRes">

        SELECT * FROM situation_publish_instance WHERE 1 = 1
        <if test="situationPublishInstanceFilterReq.name != null and situationPublishInstanceFilterReq.name != ''">
            AND name like concat("%", #{situationPublishInstanceFilterReq.name}, "%")
        </if>
        <if test="situationPublishInstanceFilterReq.category != null and situationPublishInstanceFilterReq.category != ''">
            AND category = #{situationPublishInstanceFilterReq.category}
        </if>
        <if test="situationPublishInstanceFilterReq.status != null and situationPublishInstanceFilterReq.status != ''">
            AND status = #{situationPublishInstanceFilterReq.status}
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="getAttributeIds" resultType="java.lang.String">
        SELECT attribute_id FROM situation_publish_instance
        <where>
            <if test="resourceIds != null and resourceIds.size() != 0">
                resource_id in
                <foreach collection="resourceIds" item="resourceId" open="(" close=")" separator=",">
                    #{resourceId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectPublicedByTaskId"
            resultType="com.cyberpeace.situation.dao.entity.SituationPublishInstance">

        SELECT * FROM situation_publish_instance
        <where>
            public_status = 2
            <if test="taskId != null and taskId != ''">
                and task_id = #{taskId}
            </if>
            <if test="subjectId != null and subjectId != ''">
                and subject_id = #{subjectId}
            </if>
        </where>
    </select>
</mapper>
