<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SituationTopoMapper">

    <select id="getEnvIdBySubjectIdAndTaskId" resultType="java.lang.String">
        select env_id from situation_topo_info
        <where>
            1=1
            <if test="subjectId != null and subjectId != ''">
                and subject_id = #{subjectId}
            </if>
            <if test="taskId != null and taskId != ''">
                and task_id = #{taskId}
            </if>
        </where>
        order by update_time desc
        limit 1
    </select>
</mapper>
