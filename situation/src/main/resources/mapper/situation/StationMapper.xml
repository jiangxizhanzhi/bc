<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.StationMapper">
    <select id="getStations" resultType="com.cyberpeace.situation.dao.entity.Station">
        select *
        from situation_station
        where sub_range_id = #{subRangeId}
    </select>
</mapper>