<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SubRangeContextMapper">

    <select id="getSubRanges" resultType="com.cyberpeace.situation.service.context.SubRangeContext">
        select * from situation_sub_range_context
    </select>
    <select id="getById" resultType="com.cyberpeace.situation.service.context.SubRangeContext">
        select * from situation_sub_range_context where sub_range_id = #{subRangeId}
    </select>
</mapper>