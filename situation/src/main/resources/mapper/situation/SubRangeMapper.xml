<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.SubRangeMapper">

    <select id="getSubRanges" resultType="com.cyberpeace.situation.dao.entity.SubRange">
        select * from situation_sub_range
    </select>
    <select id="getById" resultType="com.cyberpeace.situation.dao.entity.SubRange">
        select * from situation_sub_range where sub_range_id = #{subRangeId}
    </select>
</mapper>