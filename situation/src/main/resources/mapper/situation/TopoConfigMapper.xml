<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.TopoConfigMapper">
    <select id="selectByEnvId" resultType="com.cyberpeace.situation.dao.entity.TopoConfig">
        select * from situation_topo_info
        <where>
            env_id = #{envId}
        </where>
    </select>
</mapper>
