<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberpeace.situation.dao.mapper.WHLrvbMapper">

    <select id="getBusiness" resultType="com.cyberpeace.situation.model.RvbBusiness">
        select * from local_scene where mp_scene_id = #{scene_id};
    </select>

    <select id="getRvbAsset" resultType="com.cyberpeace.situation.model.RvbAsset">
        select * from cr_role_node where room_id = #{business_id};
    </select>
</mapper>
