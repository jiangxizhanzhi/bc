<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.space.dao.mapper.SpaceActionFrameMapper">

    <select id="statistics" resultType="com.cyberpeace.space.service.context.frame.ActionStatisticsBo">
