<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.space.dao.mapper.SpaceStrategyMapper">
    <select id="selectIdAndNameByFrame"
            resultType="com.cyberpeace.space.service.context.strategy.SpaceStrategySimple">
        select `resource_id`, `name`, `content` , `builtin`from space_strategy
        where frame_id = #{frameId}
        <if test="name != null and name != ''">
            <bind name="search" value="'%' + name + '%'"/>
            and `name` like #{search}
        </if>
    </select>
</mapper>