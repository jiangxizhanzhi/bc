<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyberpeace.auth.mapper.SysUserMapper">
    <select id="existByUsername" resultType="java.lang.Boolean">
        select case
                   when exists(select 1
                               from `sys_user`
                               where `username` = #{username})
                       then 1
                   else 0
                   end
                   as result;
    </select>
    <select id="pageUser" resultType="com.cyberpeace.auth.domain.SysUser">
        <if test="pattern != null and pattern != ''">
            <bind name="search" value="'%' + pattern + '%'"/>
        </if>
        select * from sys_user
        <where>
            <if test="pattern != null and pattern != ''">
                username like #{search}
                or name like #{search}
            </if>
            <if test="enabled != null">
                and enabled = #{enabled}
            </if>
        </where>
        order by id desc
    </select>
    <select id="pageUserFilterAdmin" resultType="com.cyberpeace.auth.domain.SysUser">
        <if test="pattern != null and pattern != ''">
            <bind name="search" value="'%' + pattern + '%'"/>
        </if>
        select * from sys_user where admin is not true
        <where>
            <if test="pattern != null and pattern != ''">
                username like #{search}
                or name like #{search}
            </if>
            <if test="enabled != null">
                and enabled = #{enabled}
            </if>
        </where>
        order by id desc
    </select>
    <select id="selectAllIds" resultType="java.lang.String">
        select resource_id
        from sys_user
    </select>
</mapper>